[%# INTERFACE:
  # exclude: string; a regular expression matching fields to exclude
  #   from the list of hidden fields generated by this template
  #%]

[% USE Bugzilla %]
[% cgi = Bugzilla.cgi %]

[% FOREACH field = cgi.param() %]
  [% NEXT IF exclude && field.search(exclude) %]
  [% IF field == "data" && cgi.param("data") %]
    <div class="box">
      <p>
        Det gick inte att spara filen du läste in eftersom formuläret du just
        skickade saknar uppgifter. Filen kan inte behållas mellan formuläröverföringar,
        så du måste bifoga den på nytt och fylla i de uppgifter
        som saknas ovan.
      </p>
      <p>
        Bifoga filen <b>[% cgi.param(field) FILTER html %]</b> på nytt i fältet
        nedan:
      </p>
      <p>
        <input type="file" id="data" name="data" size="50">
      </p>
    </div>
  [% ELSE %]
    [% FOREACH mvalue = cgi.param(field).slice(0) %]
      <input type="hidden" name="[% field FILTER html %]"
             value="[% mvalue FILTER html_linebreak %]">
    [% END %]
  [% END %]
[% END %]
