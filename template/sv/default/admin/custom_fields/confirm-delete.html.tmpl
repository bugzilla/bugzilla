[% PROCESS "global/field-descs.none.tmpl" %]

[% title = BLOCK %]
  Ta bort det anpassade fältet ”[% field.name FILTER html %]” ([% field.description FILTER html %])
[% END %]

[% PROCESS global/header.html.tmpl title = title style_urls = ['skins/standard/admin.css'] doc_section = "administering/custom-fields.html#deleting-custom-fields" %]

<table id="admin_table">
  <tr class="column_header"><th>Fält</th><th>Värde</th></tr>
  <tr><td>Anpassat fält</td><td>[% field.name FILTER html %]</td></tr>
  <tr><td>Beskrivning</td><td>[% field.description FILTER html %]</td></tr>
  <tr><td>Typ</td><td>[% field_types.${field.type} FILTER html %]</td></tr>
</table>

<h2>Bekräftelse</h2>

<p class="confirmation">
  Är du säker på att du vill ta bort fältet från databasen?<br>
  <em>Åtgärden lyckas bara om fältet är inaktuellt och aldrig har använts i [% terms.abug FILTER html %].</em>
</p>

<a href="editfields.cgi?action=delete&amp;name=[% field.name FILTER html %]&amp;token=[% token FILTER html %]">
  Ta bort fältet ”[% field.description FILTER html %]”</a>

<p>
  <a href="editfields.cgi">Tillbaka till listan över befintliga anpassade fält</a>
</p>

[% PROCESS global/footer.html.tmpl %]
