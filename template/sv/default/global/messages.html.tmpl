[%# This is a list of all the possible messages. Please keep them in
  # alphabetical order by message tag, and leave a blank line between messages.
  #%]

[% message_tag = message %]

[% message = BLOCK %]
  [% IF    message_tag == "account_created" %]
    Användarkontot [% otheruser.login FILTER html %] har skapats.
    [% IF groups.size %]
      Du kan nu redigera gruppinställningarna med formuläret nedan.
    [% END %]

  [% ELSIF message_tag == "account_creation_canceled" %]
    [% title = "Skapande av användarkonto avbröts" %]
    Skapandet av användarkontot [% account FILTER html %] har
    avbrutits.

  [% ELSIF message_tag == "account_updated" %]
    [% IF changes.size %]
      [% title = "Användaren $loginold har uppdaterats" %]
      Följande ändringar har gjorts i användarkontot
      [%+ loginold FILTER html %]:
      <ul>
        [% FOREACH field = changes.keys %]
          <li>
            [% IF    field == 'login_name' %]
              Inloggningsnamnet är nu [% otheruser.login FILTER html %].
            [% ELSIF field == 'realname' %]
              Det verkliga namnet har uppdaterats.
            [% ELSIF field == 'cryptpassword' %]
              Ett nytt lösenord har angetts.
            [% ELSIF field == 'disabledtext' %]
              Texten för ”inloggning avstängd” har ändrats.
            [% ELSIF field == 'is_enabled' %]
              Inloggning med användarkontot har [% otheruser.is_enabled ? 'aktiverats' : 'inaktiverats' %].
            [% ELSIF field == 'extern_id' %]
              Användarens externa inloggnings-ID har ändrats.
            [% ELSIF field == 'disable_mail' %]
              [% IF otheruser.email_disabled %]
                [% terms.Bug %]-e-post har inaktiverats.
              [% ELSE %]
                [% terms.Bug %]-e-post har aktiverats.
              [% END %]
            [% ELSIF field == 'groups' %]
              [% IF changes.groups.1.size %]
                Kontot har lagts till i grupp
                [%+ changes.groups.1.join(', ') FILTER html %]
                [% 'erna' IF changes.groups.1.size > 1 %].
              [% END %]
              [% IF changes.groups.0.size %]
                Kontot har tagits bort från grupp
                [%+ changes.groups.0.join(', ') FILTER html %]
                [% 'erna' IF changes.groups.0.size > 1 %].
              [% END %]
            [% ELSIF field == 'bless_groups' %]
              [% IF changes.bless_groups.1.size %]
                Kontot har fått rättighet att lägga till användare i grupp
                [%+ changes.bless_groups.1.join(', ') FILTER html %]
                [% 'erna' IF changes.bless_groups.1.size > 1 %].
              [% END %]
              [% IF changes.bless_groups.0.size %]
                Kontot har inte längre rättighet att lägga till användare i grupp
                [%+ changes.bless_groups.0.join(', ') FILTER html %]
                [% 'erna' IF changes.bless_groups.0.size > 1 %].
              [% END %]
            [% END %]
          </li>
        [% END %]
      </ul>
    [% ELSE %]
      [% title = "Användaren $otheruser.login har inte ändrats" %]
      Du begärde inga ändringar av användarkontot
      [%+ otheruser.login FILTER html %].
    [% END %]

  [% ELSIF message_tag == "account_deleted" %]
    [% title = "Användaren $otheruser.login har tagits bort" %]
    Användarkontot [% otheruser.login FILTER html %] har tagits bort.

  [% ELSIF message_tag == "account_disabled" %]
    Inloggning med användarkontot [% account FILTER html %] är inaktiverad, så
    du kan inte ändra dess lösenord.

  [% ELSIF message_tag == "attachment_creation_failed" %]
    [% terms.Bug %] skapades, men det gick inte att skapa bilagan.
    Lägg till bilagan genom att klicka på länken ”Lägg till bilaga”
    nedan.

  [% ELSIF message_tag == "bug_group_description" %]
    Access to [% terms.bugs %] in the [% product.name FILTER html %] product

  [% ELSIF message_tag == "buglist_adding_field" %]
    [% title = "Lägger till fält på söksidan …" %]
    [% link  = "Klicka här om sidan inte visas igen automatiskt." %]

  [% ELSIF message_tag == "buglist_updated_named_query" %]
    [% title = "Sökningen har uppdaterats" %]
    Din sökning med namnet <code><a
     href="buglist.cgi?cmdtype=runnamed&amp;namedcmd=[% queryname FILTER uri %]"
    >[% queryname FILTER html %]</a></code> har uppdaterats.

  [% ELSIF message_tag == "buglist_new_default_query" %]
    Du har nu en ny standardsökning. Du kan också
    skapa bokmärken till resultaten från enskilda sökningar.

  [% ELSIF message_tag == "buglist_new_named_query" %]
    [% title = "Sökning skapad" %]
    Du har en ny sökning med namnet <code><a
     href="buglist.cgi?cmdtype=runnamed&amp;namedcmd=[% queryname FILTER uri %]"
    >[% queryname FILTER html %]</a></code>.

  [% ELSIF message_tag == "buglist_query_gone" %]
    [% title = "Sökningen har tagits bort" %]
    [% link  = "Återställ sökningen" %]
    Sökningen <b>[% namedcmd FILTER html %]</b> har tagits bort.

  [% ELSIF message_tag == "buglist_sorted_by_relevance" %]
    [% terms.Bugs %] i listan är sorterade efter relevans, med de mest
    relevanta [% terms.bugs %] överst.

  [% ELSIF message_tag == "change_columns" %]
    [% title = "Ändra kolumner" %]
    Skickar sökningen igen med nya kolumner …
    Klicka <a href="[% redirect_url FILTER html %]">här</a>
    om sidan inte uppdateras automatiskt.

  [% ELSIF message_tag == "classification_created" %]
    [% title = "Klassificering skapad" %]
    Klassificeringen <em>[% classification.name FILTER html %]</em> har skapats.

  [% ELSIF message_tag == "classification_deleted" %]
    [% title = "Klassificering borttagen" %]
    Klassificeringen <em>[% classification.name FILTER html %]</em> har tagits bort.

  [% ELSIF message_tag == "classification_updated" %]
    [% title = "Klassificering uppdaterad" %]
    [% IF changes.keys.size %]
      Ändringar av klassificeringen <em>[% classification.name FILTER html %]</em>
      har sparats:
      <ul>
        [% IF changes.name.defined %]
          <li>Namnet har uppdaterats till ”[% classification.name FILTER html %]”</li>
        [% END %]
        [% IF changes.description.defined %]
          [% IF classification.description %]
            <li>Beskrivningen har uppdaterats till ”[% classification.description FILTER html %]”</li>
          [% ELSE %]
            <li>Beskrivningen har tagits bort</li>
          [% END %]
        [% END %]
        [% IF changes.sortkey.defined %]
          <li>Sorteringsnyckeln har uppdaterats till ”[% classification.sortkey FILTER html %]”</li>
        [% END %]
        [% Hook.process('classification_updated_fields') %]
      </ul>
    [% ELSE %]
      Inga ändringar gjordes av <em>[% classification.name FILTER html %]</em>.
    [% END %]

  [% ELSIF message_tag == "component_created" %]
    [% title = "Komponent skapad" %]
    Komponenten <em>[% comp.name FILTER html %]</em> har skapats.

  [% ELSIF message_tag == "component_deleted" %]
    [% title = "Komponent borttagen" %]
    Komponenten <em>[% comp.name FILTER html %]</em> har tagits bort.
    [% IF comp.bug_count %]
      Alla [% terms.bugs %] i komponenten och alla hänvisningar
      till dem har också tagits bort.
    [% END %]

  [% ELSIF message_tag == "component_updated" %]
    [% title = "Komponent uppdaterad" %]
    [% IF changes.keys.size %]
      Ändringar av komponenten <em>[% comp.name FILTER html %]</em> har sparats:
      <ul>
      [% IF changes.name.defined %]
        <li>Namnet har uppdaterats till ”[% comp.name FILTER html %]”</li>
      [% END %]
      [% IF changes.description.defined %]
        <li>Beskrivningen har uppdaterats till ”[% comp.description FILTER html_light %]”</li>
      [% END %]
      [% IF changes.initialowner.defined %]
        <li>Standardtilldelad har uppdaterats till ”[% comp.default_assignee.login FILTER html %]”</li>
      [% END %]
      [% IF changes.initialqacontact.defined %]
        [% IF comp.default_qa_contact %]
          <li>Standardkontakt för kvalitetssäkring har uppdaterats till ”[% comp.default_qa_contact.login FILTER html %]”</li>
        [% ELSE %]
          <li>Standardkontakt för kvalitetssäkring har tagits bort</li>
        [% END %]
      [% END %]
      [% IF changes.cc_list.defined %]
        [% IF comp.initial_cc.size %]
          [% cc_list = [] %]
          [% FOREACH cc_user = comp.initial_cc %]
            [% cc_list.push(cc_user.login) %]
          [% END %]
          <li>Standard-CC-listan har uppdaterats till [% cc_list.join(", ") FILTER html %]</li>
        [% ELSE %]
          <li>Standard-CC-listan har tagits bort</li>
        [% END %]
      [% END %]
      [% IF changes.isactive.defined %]
          <li>[% comp.is_active ? "Aktiverad" : "Inaktiverad" %] för [% terms.bugs %]</li>
      [% END %]
      [% Hook.process('component_updated_fields') %]
      </ul>
    [% ELSE %]
      Inga ändringar gjordes av <em>[% comp.name FILTER html %]</em>.
    [% END %]

  [% ELSIF message_tag == "custom_field_created" %]
    [% title = "Anpassat fält skapat" %]
    Det nya anpassade fältet ”[% field.name FILTER html %]” har
    skapats.

  [% ELSIF message_tag == "custom_field_deleted" %]
    [% title = "Anpassat fält borttaget" %]
    Det anpassade fältet ”[% field.name FILTER html %]” har
    tagits bort.

  [% ELSIF message_tag == "custom_field_updated" %]
    [% title = "Anpassat fält uppdaterat" %]
    Egenskaperna för fältet ”[% field.name FILTER html %]” har
    uppdaterats.

  [% ELSIF message_tag == "default_settings_updated" %]
    [% IF changes_saved %]
      Ändringarna av standardinställningarna har sparats.
    [% ELSE %]
      Inga ändringar gjordes.
    [% END %]

  [% ELSIF message_tag == "emailold_change_canceled" %]
    [% title = "Avbryt begäran om byte av e-postadress" %]
    Begäran om att ändra e-postadressen för ditt konto till
    [%+ new_email FILTER html %] har avbrutits.

  [% ELSIF message_tag == "email_change_canceled" %]
    [% title = "Avbryt begäran om byte av e-postadress" %]
    Begäran om att ändra e-postadressen för
    kontot [%+ old_email FILTER html %] till
    [%+ new_email FILTER html %] har avbrutits.

  [% ELSIF message_tag == "email_change_canceled_reinstated" %]
    [% title = "Avbryt begäran om byte av e-postadress" %]
    Begäran om att ändra e-postadressen för
    kontot [%+ old_email FILTER html %] till
    [%+ new_email FILTER html %] har avbrutits.
    Dina tidigare kontoinställningar har återställts.

  [% ELSIF message_tag == "extension_created" %]
    Ett tillägg med namnet [% name FILTER html %] har skapats
    i [% path FILTER html %].

  [% ELSIF message_tag == "field_value_created" %]
    [% title = "Nytt fältvärde skapat" %]
    Värdet <em>[% value.name FILTER html %]</em> har lagts till som ett
    giltigt val för fältet <em>[% field.description FILTER html %]</em>
    (<em>[% field.name FILTER html %]</em>) field.
    [% IF field.name == "bug_status" %]
      Du bör nu gå till <a href="editworkflow.cgi">sidan för statusflöden</a>
      för att inkludera den nya [% terms.bug %]-statusen.
    [% END %]

  [% ELSIF message_tag == "field_value_deleted" %]
    [% title = "Fältvärde borttaget" %]
    Värdet <em>[% value.name FILTER html %]</em> för
    <em>[% field.description FILTER html %]</em>
    fältet (<em>[% field.name FILTER html %]</em>) har tagits bort.

  [% ELSIF message_tag == "field_value_updated" %]
    [% title = "Fältvärde uppdaterat" %]
    [% IF changes.keys.size %]
      Värdet <em>[% value_old FILTER html %]</em> för
      <em>[% field.description FILTER html %]</em>
      fältet (<em>[% field.name FILTER html %]</em>) har ändrats:
      <ul>
        [% IF changes.value %]
          <li>Fältvärdet har uppdaterats till
            <em>[% changes.value.1 FILTER html %]</em>.
            [% IF value.is_default %]
              (Observera att detta värde är standardvärdet för fältet. Alla
              hänvisningar till standardvärdet pekar nu på det nya värdet.)
            [% END %]
          </li>
        [% END %]
        [% IF changes.sortkey %]
          <li>Sorteringsnyckeln har uppdaterats till
            <em>[% changes.sortkey.1 FILTER html %]</em>.</li>
        [% END %]
        [% IF changes.visibility_value_id %]
          [% IF value.visibility_value.defined %]
            <li>Det visas endast när
              [%+ value.field.value_field.description FILTER html %] är inställt på
              ”[%+ value.visibility_value.name FILTER html %]”.</li>
          [% ELSE %]
            <li>Det visas nu alltid, oavsett vilket värde
              [%+ value.field.value_field.description FILTER html %] är inställt på.
            </li>
          [% END %]
        [% END %]
      </ul>
    [% ELSE %]
      Inga ändringar gjordes av fältvärdet <em>[% value_old FILTER html %]</em>.
    [% END %]

  [% ELSIF message_tag == "flag_cleared" %]
    Vissa flaggor gällde inte i den nya produkten/komponenten
    och har rensats.

  [% ELSIF message_tag == "flag_creation_failed" %]
    [% title = "Det gick inte att skapa flaggor" %]
    Ett fel uppstod när flaggor validerades:
    [%+ flag_creation_error FILTER none %]

  [% ELSIF message_tag == "get_field_desc" %]
    [% field_descs.$field_name FILTER html %]

  [% ELSIF message_tag == "get_resolution" %]
    [% display_value("resolution", resolution) FILTER html %]

  [% ELSIF message_tag == "get_status" %]
    [% display_value("bug_status", status) FILTER html %]

  [% ELSIF message_tag == "group_created" %]
    [% title = "Ny grupp skapad" %]
    Gruppen <em>[% group.name FILTER html %]</em> har skapats.

  [% ELSIF message_tag == "group_deleted" %]
    [% title = "Grupp borttagen" %]
    Gruppen <em>[% name FILTER html %]</em> har tagits bort.

  [% ELSIF message_tag == "group_membership_removed" %]
    [% title = "Gruppmedlemskap borttaget" %]
    [% IF users.size %]
      Direkt medlemskap i gruppen <em>[% group FILTER html %]</em> har tagits bort
      [% IF regexp %] för användare som matchar ”[% regexp FILTER html %]”[% END %]:
      [% FOREACH user = users %]
        [%+ user.login FILTER html %]
      [% END %]
    [% ELSE %]
      Din åtgärd påverkar inga användare.
    [% END %]

  [% ELSIF message_tag == "group_updated" %]
    [% IF changes.keys.size %]
      Följande ändringar har gjorts i gruppen ”[% group.name FILTER html %]”:
      <ul>
      [% FOREACH field = changes.keys.sort %]
        [% SWITCH field %]
          [% CASE 'name' %]
            <li>Namnet ändrades till ”[% changes.name.1 FILTER html %]”</li>
          [% CASE 'description' %]
            <li>Beskrivningen har uppdaterats.</li>
          [% CASE 'userregexp' %]
            <li>Det reguljära uttrycket har uppdaterats.</li>
          [% CASE 'isactive' %]
            [% IF changes.isactive.1 %]
              <li>Gruppen används nu för [% terms.bugs %].</li>
            [% ELSE %]
              <li>Gruppen används inte längre för [% terms.bugs %].</li>
            [% END %]
          [% CASE 'icon_url' %]
            <li>URL:en för gruppikonen har uppdaterats.</li>
          [% CASE 'members_add' %]
            <li>Följande grupper är nu medlemmar i denna grupp:
              [%+ changes.members_add.join(', ') FILTER html %]</li>
          [% CASE 'members_remove' %]
            <li>Följande grupper är inte längre medlemmar i denna grupp:
              [%+ changes.members_remove.join(', ') FILTER html %]</li>
          [% CASE 'member_of_add' %]
            <li>Denna grupp är nu medlem i följande grupper:
              [%+ changes.member_of_add.join(', ') FILTER html %]</li>
          [% CASE 'member_of_remove' %]
            <li>Denna grupp är inte längre medlem i följande grupper:
              [%+ changes.member_of_remove.join(', ') FILTER html %]</li>
          [% CASE 'bless_from_add' %]
            <li>Följande grupper kan nu lägga till användare i denna grupp:
              [%+ changes.bless_from_add.join(', ') FILTER html %]</li>
          [% CASE 'bless_from_remove' %]
            <li>Följande grupper kan inte längre lägga till användare i denna grupp:
              [%+ changes.bless_from_remove.join(', ') FILTER html %]</li>
          [% CASE 'bless_to_add' %]
            <li>Denna grupp kan nu lägga till användare i följande grupper:
              [%+ changes.bless_to_add.join(', ') FILTER html %]</li>
          [% CASE 'bless_to_remove' %]
            <li>Denna grupp kan inte längre lägga till användare i följande grupper:
              [%+ changes.bless_to_remove.join(', ') FILTER html %]</li>
          [% CASE 'visible_from_add' %]
            <li>Följande grupper kan nu se användare i denna grupp:
              [%+ changes.visible_from_add.join(', ') FILTER html %]</li>
          [% CASE 'visible_from_remove' %]
            <li>Följande grupper kan inte längre se användare i denna grupp:
              [%+ changes.visible_from_remove.join(', ') FILTER html %]</li>
          [% CASE 'visible_to_me_add' %]
            <li>Denna grupp kan nu se användare i följande grupper:
              [%+ changes.visible_to_me_add.join(', ') FILTER html %]</li>
          [% CASE 'visible_to_me_remove' %]
            <li>Denna grupp kan inte längre se användare i följande grupper:
              [%+ changes.visible_to_me_remove.join(', ') FILTER html %]</li>
          [% CASE %]
            [% Hook.process('group_updated_fields') %]
        [% END %]
      [% END %]
      </ul>
    [% ELSE %]
      Du begärde inga ändringar för gruppen ”[% group.name FILTER html %]”.
    [% END %]

  [% ELSIF message_tag == "invalid_column_name" %]
    Den angivna anpassade sorteringsordningen innehåller ett eller flera ogiltiga
    kolumnnamn: <em>[% invalid_fragments.join(', ') FILTER html %]</em>.
    De har tagits bort från sorteringslistan.

  [% ELSIF message_tag == "job_queue_depth" %]
    [% count FILTER html %] jobb i kön.

  [% ELSIF message_tag == "keyword_created" %]
    [% title = "Nytt nyckelord skapat" %]
    Nyckelordet <em>[% name FILTER html %]</em> har skapats.

  [% ELSIF message_tag == "keyword_deleted" %]
    [% title = "Nyckelord borttaget" %]
    Nyckelordet <em>[% keyword.name FILTER html %]</em> har tagits bort.

  [% ELSIF message_tag == "keyword_updated" %]
    [% title = "Nyckelord uppdaterat" %]
    [% IF changes.keys.size %]
      Ändringar av nyckelordet <em>[% keyword.name FILTER html %]</em> har
      sparats:
      <ul>
        [% IF changes.name.defined %]
          <li>Nyckelordet har bytt namn till <em>[% keyword.name FILTER html %]</em>.</li>
        [% END %]
        [% IF changes.description.defined %]
          <li>Beskrivningen har uppdaterats till <em>[% keyword.description FILTER html %]</em></li>
        [% END %]
      </ul>
    [% ELSE %]
      Inga ändringar gjordes.
    [% END %]

  [% ELSIF message_tag == "logged_out" %]
    [% title = "Utloggad" %]
    [% url = "index.cgi?GoAheadAndLogIn=1" %]
    [% link = "Logga in igen." %]
    <b>Du har loggats ut</b>.
    Kakan som sparade din inloggning har tagits bort. Du kommer att
    uppmanas att logga in nästa gång det krävs.

  [% ELSIF message_tag == "mail_delivery_warnings" %]
    [% title = "Problem med e-postleverans" %]
    [% IF mail_warnings.size == 1 %]
      Bugzilla kunde inte skicka e-post i kö.
    [% ELSE %]
      Bugzilla kunde inte skicka e-post i kö för [% mail_warnings.size %] meddelanden.
    [% END %]
    Granska dina
    <a href="editparams.cgi?section=mta#mail_delivery_method_desc">inställningar för e-postleverans</a>.
    <ul>
      [% FOREACH warning = mail_warnings %]
        <li>[% warning.method FILTER html %]: [% warning.error FILTER html %]</li>
      [% END %]
    </ul>

  [% ELSIF message_tag == "login_changed" %]
    [% title = "$terms.Bugzilla-inloggning har ändrats" %]
    Din [% terms.Bugzilla %]-inloggning har ändrats.

  [% ELSIF message_tag == "migrate_component_created" %]
    Komponent skapad: [% comp.name FILTER html %]
    (i [% product.name FILTER html %])

  [% ELSIF message_tag == "migrate_creating_bugs" %]
    Skapar [% terms.bugs %] …

  [% ELSIF message_tag == "migrate_field_created" %]
    Nytt anpassat fält: [% field.description FILTER html %]
    ([% field.name FILTER html %])

  [% ELSIF message_tag == "migrate_product_created" %]
    Produkt skapad: [% created.name FILTER html %]

  [% ELSIF message_tag == "migrate_reading_bugs" %]
    Läser in [% terms.bugs %] …

  [% ELSIF message_tag == "migrate_reading_products" %]
    Läser in produkter …

  [% ELSIF message_tag == "migrate_reading_users" %]
    Läser in användare …

  [% ELSIF message_tag == "migrate_translating_bugs" %]
    Konverterar [% terms.bug %]-värden för
    [%+ terms.Bugzilla %] …

  [% ELSIF message_tag == "migrate_user_created" %]
    Användare skapad: [% created.email FILTER html %]
    [% IF password %] Lösenord: [% password FILTER html %][% END %]

