[% bugidsummary = bug.bug_id _ ': ' _ bug.short_desc %]
[% attidsummary = attachment.id _ ': ' _ attachment.description %]
[% flagtype_name = flag ? flag.type.name : old_flag.type.name %]
[% statuses = { '+' => "beviljad" , '-' => 'nekad' , 'X' => "avbruten" ,
                '?' => "begärd" } %]

[% to_identity = "" %]
[% on_behalf_of = 0 %]
[% action = flag.status || 'X' %]

[% IF flag && flag.status == '?' %]
  [% subject_status = "begärd" %]
  [% IF flag.setter_id == user.id %]
    [% to_identity = flag.requestee.identity _ " för" %]
  [% ELSE %]
    [% on_behalf_of = 1 %]
    [% IF flag.requestee %][% to_identity = " till " _ flag.requestee.identity %][% END %]
  [% END %]
[% ELSE %]
  [% IF old_flag && old_flag.status == '?' %]
    [% to_identity = old_flag.setter.identity _ ":s begäran om" %]
    [% IF old_flag.requestee.defined %]
        [% requestee_identity = old_flag.requestee.identity _ ":s" %]
    [% END %]
  [% END %]
  [% subject_status = statuses.$action %]
[% END %]
From: [% Param('mailfrom') %]
To: [% to %]
Subject: [% flagtype_name %] [%+ subject_status %]: [[% terms.Bug %] [%+ bug.bug_id %]] [% bug.short_desc %]
[%- IF attachment %] :
  [Bilaga [% attachment.id %]] [% attachment.description FILTER clean_text %][% END %]
Date: [% date %]
X-Bugzilla-Type: request
[%+ INCLUDE "email/header-common.txt.tmpl" %]
[%+ threadingmarker %]

[%+ USE wrap -%]
[%- FILTER bullet = wrap(80) -%]

[% IF on_behalf_of %]
[% user.identity %] har omtilldelat [% flag.setter.identity %]:s begäran om [% IF requestee_identity %] [%+ requestee_identity %] [% END %] [% flagtype_name %]
[% to_identity %]:
[% ELSE %]
[% user.identity %] har [% statuses.$action %] [%+ to_identity %] [% IF requestee_identity %] [%+ requestee_identity %] [% END %] [%+ flagtype_name %]:
[% END %]

[% terms.Bug %] [%+ bugidsummary %]
[% END %]
[%+ urlbase %]show_bug.cgi?id=[% bug.bug_id %]
[% IF attachment %]

[% FILTER bullet = wrap(80) %]
Bilaga [% attidsummary %]
[%- END %]
[%+ urlbase %]attachment.cgi?id=[% attachment.id %]&action=edit
[%- END %]

[%- Hook.process('after_summary') -%]

[%- FILTER bullet = wrap(80) %]

[% FOREACH comment = new_comments %]

[%- IF comment.count %]
--- Kommentar #[% comment.count %] från [% comment.author.identity %] ---
[% ELSE %]
--- Beskrivning ---
[% END %]
[%+ comment.body_full({ is_bugmail => 1, wrap => 1 }) FILTER strip_control_chars %]
[% END %]

[%- END %]

