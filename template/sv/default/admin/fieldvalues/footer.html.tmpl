<hr>

<p>

[% UNLESS no_add_link %]
  <a title="Lägg till ett värde för fältet '[% field.description FILTER html %]'."
     href="editvalues.cgi?action=add&amp;field=
          [%- field.name FILTER uri %]">Lägg till</a> ett värde.
[% END %]

[% IF value.defined && !no_edit_link %]
  Redigera värdet <a
  title="Redigera värdet '[% value.name FILTER html %]' för fältet '
         [%- field.name FILTER html %]'"
  href="editvalues.cgi?action=edit&amp;field=
        [%- field.name FILTER uri %]&amp;value=
        [%- value.name FILTER uri %]">
        '[% value.name FILTER html %]'</a>.
[% END %]

[% UNLESS no_edit_other_link %]
  Redigera andra värden för fältet <a
  href="editvalues.cgi?field=
        [%- field.name FILTER uri %]">'[% field.description FILTER html %]'</a>.

[% END %]

</p>
