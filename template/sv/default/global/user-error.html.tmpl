  [% ELSIF error == "product_name_diff_in_case" %]
    [% title = "Produktnamnet skiljer endast i skiftläge" %]
    [% admindocslinks = {'categorization.html#products' => 'Administrera produkter'} %]
    Produktnamnet ”[% product FILTER html %]” skiljer sig från den befintliga
    produkten ”[% existing_product FILTER html %]” endast i skiftläge.

  [% ELSIF error == "product_name_too_long" %]
    [% title = "Produktnamnet är för långt" %]
    Namnet på en produkt är begränsat till [% constants.MAX_PRODUCT_SIZE FILTER html %]
    tecken. ”[% name FILTER html %]” är för långt ([% name.length %] tecken).

  [% ELSIF error == "product_must_define_defaultmilestone" %]
    [% title = "Ny standardmilstolpe måste anges" %]
    [% admindocslinks = {'categorization.html#products'   => 'Administrera produkter',
                         'categorization.html#milestones' => 'Om milstolpar'} %]
    Du måste <a href="editmilestones.cgi?action=add&amp;product=[% product FILTER uri %]">
    skapa milstolpen ”[% milestone FILTER html %]”</a> innan den kan
    användas som standardmilstolpe för produkten ”[% product FILTER html %]”.

  [% ELSIF error == "product_admin_denied" %]
    [% title = "Åtkomst till produkten nekad" %]
    Du får inte ändra egenskaper för produkten ”[% product FILTER html %]”.

  [% ELSIF error == "product_blank_name" %]
    [% title = "Tomt produktnamn är inte tillåtet" %]
    [% admindocslinks = {'categorization.html#products' => 'Administrera produkter'} %]
    Du måste ange ett namn för produkten.
  
  [% ELSIF error == "product_disabled" %]
    [% title = BLOCK %]Produkten är stängd för registrering av [% terms.bug %][% END %]
    [% admindocslinks = {'categorization.html#products' => 'Administrera produkter'} %]
    Det går inte att registrera [% terms.abug %] i produkten
    <em>[% product.name FILTER html %]</em>.

  [% ELSIF error == "product_edit_denied" %]
    [% title = "Åtkomst för att ändra produkt nekad" %]
    [% admindocslinks = {'categorization.html#products' => 'Administrera produkter',
                         'categorization.html#assigning-group-controls-to-products' => 'Gruppsäkerhet'} %]
    Du får inte ändra [% terms.bugs %] i produkten
    [%+ product FILTER html %].

  [% ELSIF error == "product_has_bugs" %]
    [% title = BLOCK %]Produkten har [% terms.Bugs %][% END %]
    [% admindocslinks = {'categorization.html#products' => 'Administrera produkter'} %]
    Det finns [% nb FILTER html %] [%+ terms.bugs %] registrerade för produkten.
    Du måste flytta dessa [% terms.bugs %] till en annan produkt innan
    du kan ta bort den här.

  [% ELSIF error == "product_must_have_description" %]
    [% title = "Produkten behöver en beskrivning" %]
    [% admindocslinks = {'categorization.html#products' => 'Administrera produkter'} %]
    Du måste ange en beskrivning för produkten.

  [% ELSIF error == "product_must_have_version" %]
    [% title = "Produkten behöver en version" %]
    [% admindocslinks = {'categorization.html#products' => 'Administrera produkter',
                         'categorization.html#versions' => 'Administrera versioner'} %]
    Du måste ange en giltig version för att skapa en ny produkt.

  [% ELSIF error == "product_unknown_component" %]
    [% title = "Okänd komponent" %]
    Produkten ”[% product FILTER html %]” har ingen komponent
    [% IF comp_id %]
      med ID [% comp_id FILTER html %].
    [% ELSE %]
      med namnet ”[% comp FILTER html %]”.
    [% END %]

  [% ELSIF error == "query_name_missing" %]
    [% title = "Inget söknamn har angetts" %]
    [% docslinks = {'using/finding.html#bug-lists' => "Listor med $terms.bugs"} %]
    Du måste ange ett namn för sökningen.

  [% ELSIF error == "query_name_too_long" %]
    [% title = "Söknamnet är för långt" %]
    Sökningens namn måste vara kortare än [% constants.MAX_LEN_QUERY_NAME FILTER html %]
    tecken.

  [% ELSIF error == "quicksearch_invalid_query" %]
    [% title = "Ogiltig sökning" %]
    Sökningen är ogiltig.
    [% IF operators %]
      Operatorn [% operators.shift FILTER html %] kan inte följas av
      [%+ operators.shift FILTER html %].
    [% ELSE %]
      En sökning kan inte börja med AND eller OR, och inte heller sluta med AND,
      OR eller NOT. De är reserverade operatorer och måste omges av citattecken
      om du vill söka efter dessa strängar.
    [% END %]

  [% ELSIF error == "quicksearch_unbalanced_quotes" %]
    [% title = "Felaktigt formaterad sökning" %]
    [% terms.Bugzilla %] kan inte tolka sökningen korrekt:
    <em>[% string FILTER html %]</em>.<br>
    Om du använder citattecken för att avgränsa strängar måste båda finnas med.
    Om du vill söka efter ett citattecken i en sträng skriver du \" i stället för ".
    Exempelvis tolkas <em>"I'm so \"special\", really"</em> (med citattecken) som
    <em>I'm so "special", really</em>.

  [% ELSIF error == "quicksearch_unknown_field" %]
    [% title = "QuickSearch-fel" %]
    Det finns ett problem med sökningen:
    [% FOREACH field = unknown %]
      <p><code>[% field FILTER html %]</code> är inte ett giltigt fältnamn.</p>
    [% END %]
    [% FOREACH field = ambiguous.keys %]
      <p><code>[% field FILTER html %]</code> matchar fler än ett fält:
        [%+ ambiguous.${field}.join(', ') FILTER html %]</p>
    [% END %]

    [% IF unknown.size %]
      <p>De giltiga fältnamnen
        <a href="page.cgi?id=quicksearch.html#fields">finns här</a>.</p>
    [% END %]

  [% ELSIF error == "quip_too_long" %]
    [% title = "Citatet är för långt" %]
    Du angav ett citat med [% length FILTER none %] tecken, men högsta tillåtna
    längd är [% constants.MAX_QUIP_LENGTH FILTER none %] tecken.

  [% ELSIF error == "reassign_to_empty" %]
    [% title = "Ogiltig omtilldelning" %]
    För att tilldela om [% terms.abug %] måste du ange en adress till
    den nya ansvariga personen.

  [% ELSIF error == "report_axis_invalid" %]
    [% title = "Ogiltig axel" %]
    <em>[% val FILTER html %]</em> är inte ett giltigt värde för fältet
    [%+ IF    fld == "x" %]horisontell axel
    [%+ ELSIF fld == "y" %]vertikal axel
    [%+ ELSIF fld == "z" %]flera tabeller/bilder
    [%+ ELSE %]rapportaxel[% END %].

  [% ELSIF error == "report_name_missing" %]
    [% title = "Inget rapportnamn har angetts" %]
    Du måste ange ett namn för rapporten.

  [% ELSIF error == "report_access_denied" %]
    [% title = "Åtkomst till rapport nekad" %]
    Du kan inte komma åt rapporten.

  [% ELSIF error == "require_component" %]
    [% title = "Komponent krävs" %]
    För att rapportera [% terms.bug %] måste du först välja en komponent.
    Gissa om det behövs.

  [% ELSIF error == "relationship_loop_single" %]
    [% title = "Relationship Loop Detected" %]
    [% field_descs.$field_name FILTER html %]
    for [% terms.bug %] [%+ bug_id FILTER html %]
    har ett cirkulärt beroende av [% terms.bug %] [%+ dep_id FILTER html %].

  [% ELSIF error == "request_queue_group_invalid" %]
    Gruppfältet <em>[% group FILTER html %]</em> är ogiltigt.

  [% ELSIF error == "require_new_password" %]
    [% title = "Nytt lösenord krävs" %]
    Du kan inte ändra lösenordet utan att välja ett nytt.

  [% ELSIF error == "required_field" %]
    [% title = "Fältet måste anges" %]
    Ett värde måste anges för fältet ”[% field_descs.${field.name} FILTER html %]”.

  [% ELSIF error == "require_summary" %]
    [% title = "Sammanfattning krävs" %]
    Du måste ange en sammanfattning för [% terms.bug %].

  [% ELSIF error == "resolution_cant_clear" %]
    [% terms.Bug %] [%+ bug_id FILTER bug_link(bug_id) FILTER none %]
    är stängd och därför kan du inte rensa dess lösning.

  [% ELSIF error == "resolution_not_allowed" %]
    [% title = "Lösning är inte tillåten" %]
    Du kan inte ange en lösning för öppna [% terms.bugs %].

  [% ELSIF error == "saved_search_used_by_whines" %]
    [% title = "Den sparade sökningen används" %]
    [% docslinks = {'administering/whining.html' => 'Om bevakningar'} %]
    Den sparade sökningen <em>[% search_name FILTER html %]</em> används
    av <a href="editwhines.cgi">bevakningar</a> med följande ämnen:
    [%+ subjects FILTER html %]

  [% ELSIF error == "search_content_without_matches" %]
    [% title = "Ogiltig sökning" %]
    Fältet ”content” kan endast användas med sökningen ”matches”,
    och sökningen ”matches” kan endast användas med fältet ”content”.

  [% ELSIF error == "search_grouped_field_invalid" %]
    [% terms.Bugzilla %] har inte stöd för att använda fältet
    "[%+ field_descs.$field FILTER html %]" ([% field FILTER html %])
    med grupperade sökvillkor.

  [% ELSIF error == "search_grouped_invalid_nesting" %]
    Du kan inte nästla satser i grupperade sökvillkor.

  [% ELSIF error == "search_grouped_field_mismatch" %]
    Alla villkor i en grupperad sökning måste använda samma fält.

  [% ELSIF error == "search_field_operator_invalid" %]
    [% terms.Bugzilla %] har inte stöd för att använda fältet
    "[%+ field_descs.$field FILTER html %]" ([% field FILTER html %])
    med söktypen ”[% search_descs.$operator FILTER html %]”
    ([% operator FILTER html %]).

  [% ELSIF error == "see_also_self_reference" %]
    Du kan inte lägga [% terms.bug %] i dess eget fält
    [%+ field_descs.see_also FILTER html %].

  [% ELSIF error == "series_already_exists" %]
    [% title = "Serien finns redan" %]
    [% docslinks = {'using/reports-and-charts.html' => 'Rapportering'} %]
      En serie med namnet <em>[% series.category FILTER html %] /
      [%+ series.subcategory FILTER html %] / 
      [%+ series.name FILTER html %]</em>
      finns redan.
    
  [% ELSIF error == "still_unresolved_bugs" %]
    [% title = "Olösta beroenden" %]
    [% IF bug_id %]
      [% terms.Bug %] [%+ bug_id FILTER bug_link(bug_id) FILTER none %]
    [% ELSE %]
       Den här [% terms.bug %]
    [% END %]
    har [% dep_count FILTER none %] olösta
    [% IF dep_count == 1 %]
      beroende
    [% ELSE %]
      beroenden
    [% END %].
    De måste antingen lösas eller tas bort från fältet
    ”[% field_descs.dependson FILTER html %]” innan du kan markera
    [% terms.bug %] som [% display_value("resolution", "FIXED") FILTER html %].

  [% ELSIF error == "sudo_invalid_cookie" %]
    [% title = "Ogiltig sudo-kaka" %]
    Sudo-kakan är ogiltig. Den har antingen gått ut eller så startades inte
    sudo-sessionen korrekt. Uppdatera sidan eller läs in en annan sida för
    att fortsätta som dig själv.

  [% ELSIF error == "sudo_illegal_action" %]
    [% title = "Imitation är inte tillåten" %]
    [% IF NOT sudoer.in_group("bz_sudoers") %]
      Du får inte agera som andra användare.
    [% ELSIF target_user AND target_user.in_group("bz_sudo_protect") %]
      Du får inte agera som [% target_user.identity FILTER html %].
    [% ELSE %]
      Användaren du försökte agera som finns inte.
    [% END %]

  [% ELSIF error == "sudo_in_progress" %]
    [% title = "En session pågår" %]
    En sudo-session där du agerar som [% target FILTER html %] pågår.
    Avsluta sessionen med länken i sidfoten innan du startar en ny.

  [% ELSIF error == "sudo_password_required" %]
    [% title = "Lösenord krävs" %]
    Ditt lösenord för [% terms.Bugzilla %] krävs för att starta en sudo-
    session. <a href="relogin.cgi?action=prepare-sudo&amp;target_login=
    [%- target_login FILTER uri %]&amp;reason=
    [%- reason FILTER uri %]">Gå tillbaka</a> och ange lösenordet.
    
  [% ELSIF error == "sudo_preparation_required" %]
    [% title = "Förberedelse krävs" %]
    Du får inte starta en sudo-session direkt.
    <a href="relogin.cgi?action=prepare-sudo&amp;target_login=
    [%- target_login FILTER uri %]&amp;reason=
    [%- reason FILTER uri %]">Starta sessionen på vanligt sätt</a>.

  [% ELSIF error == "sudo_protected" %]
    [% title = "Användaren är skyddad" %]
    Användaren [% login FILTER html %] får inte imiteras av sudo-användare.

  [% ELSIF error == "tag_name_too_long" %]
    [% title = "Etikettnamnet är för långt" %]
    Etiketten måste vara kortare än [% constants.MAX_LEN_QUERY_NAME FILTER html %]
    tecken.

  [% ELSIF error == "token_does_not_exist" %]
    [% title = "Tokenet finns inte" %]
    Tokenet du skickade in finns inte, har gått ut eller har
    återkallats.

  [% ELSIF error == "too_soon_for_new_token" %]
    [% title = "För tidigt för nytt token" %]
    Du har begärt
    [% IF type == "password" %]
      ett lösenords-
    [% ELSIF type == "account" %]
      ett konto-
    [% END %]
    token för nyligen för att kunna begära ett till.
    Vänta [% constants.ACCOUNT_CHANGE_INTERVAL FILTER html %] minuter och försök igen.

  [% ELSIF error == "unknown_action" %]
    [% title = "Okänd åtgärd" %]
    [% IF action %]
      Okänd åtgärd ”[% action.truncate(20, "...") FILTER html %]”.
    [% ELSE %]
      Det gick inte att avgöra vad du ville göra.
    [% END %]

  [% ELSIF error == "unknown_tab" %]
    [% title = "Okänd flik" %]
    Det finns ingen flik med namnet <code>[% current_tab_name FILTER html %]</code>.

  [% ELSIF error == "value_inactive" %]
    [% title = "Värdet är inte aktivt" %]
    [% type = BLOCK %][% INCLUDE object_name class = class %][% END %]
    Värdet ”[% value FILTER html %]” för [% type FILTER html %] är inte aktivt.

  [% ELSIF error == "version_already_exists" %]
    [% title = "Versionen finns redan" %]
    [% admindocslinks = {'categorization.html#versions' => 'Administrera versioner'} %]
    Versionen ”[% name FILTER html %]” finns redan för produkten ”
    [%- product FILTER html %]”.

  [% ELSIF error == "version_blank_name" %]
    [% title = "Tomt versionsnamn är inte tillåtet" %]
    Du måste ange ett namn för versionen.

  [% ELSIF error == "version_has_bugs" %]
    [% title = BLOCK %]Versionen har [% terms.Bugs %][% END %]
    Det finns [% nb FILTER html %] [%+ terms.bugs %] som är kopplade till versionen.
    Du måste tilldela om dessa [% terms.bugs %] till en annan version innan
    du kan ta bort den här.

  [% ELSIF error == "version_is_last" %]
    [% title = BLOCK %]Sista versionen i produkten[% END %]
    ”[% version.name FILTER html %]” är den sista versionen i produkten
    ”[% version.product.name FILTER html %]”. Du kan inte ta bort den.

  [% ELSIF error == "users_deletion_disabled" %]
    [% title = "Borttagning är inte aktiverad" %]
    [% admindocslinks = {'users.html#deleting-users' => 'Användaradministration'} %]
    Det går inte att ta bort användarkonton.

  [% ELSIF error == "user_has_responsibility" %]
    [% title = "Det går inte att ta bort användarkontot" %]
    [% admindocslinks = {'users.html#deleting-users' => 'Användaradministration'} %]
    Användaren du vill ta bort är angiven som standardansvarig för [% terms.bug %]
    [% IF Param('useqacontact') %]
      eller QA-kontakt
    [% END %]
    för minst en komponent. Därför kan kontot inte tas bort just nu.

  [% ELSIF error == "user_access_by_id_denied" %]
    [% title = "Åtkomst till användare via ID nekad" %]
    Utloggade användare kan inte använda argumentet ”ids” för den här funktionen
    för att komma åt användaruppgifter.

  [% ELSIF error == "user_access_by_match_denied" %]
    [% title = "Användarmatchning nekad" %]
    Utloggade användare kan inte använda argumentet ”match” för den här funktionen
    för att komma åt användaruppgifter.

  [% ELSIF error == "user_login_required" %]
    [% title = "Inloggningsnamn krävs" %]
    [% admindocslinks = {'users.html' => 'Användaradministration'} %]
    Du måste ange ett inloggningsnamn för den nya användaren.

  [% ELSIF error == "user_match_failed" %]
    [% title = "Matchning misslyckades" %]
    <kbd>[% name FILTER html %]</kbd> finns inte eller så får du inte
    se användaren.

  [% ELSIF error == "user_match_too_many" %]
    [% title = "Ingen entydig matchning" %]
    [% terms.Bugzilla %] kan inte göra en entydig matchning för ett eller flera
    av namnen eller e-postadresserna du angav i fältet eller fälten
    [% fields.join(', ') FILTER html %].

  [% ELSIF error == "user_not_insider" %]
    [% title = "Användaren finns inte i intern grupp" %]
    Du får inte markera eller avmarkera kommentarer eller bilagor som privata.

  [% ELSIF error == "user_not_involved" %]
    [% title = "Användaren är inte involverad i $terms.Bug" %]
    Du är inte involverad i [% terms.Bug %] [%+
        bug_id FILTER bug_link(bug_id) FILTER none %].

  [% ELSIF error == "webdot_too_large" %]
    [% title = "Beroendediagrammet är för stort" %]
    Beroendediagrammet innehåller för många [% terms.bugs %] för att visas (fler
    än [% constants.MAX_WEBDOT_BUGS FILTER html %] [%+ terms.bugs %]).

  [% ELSIF error == "wrong_token_for_cancelling_email_change" %]
    [% title = "Fel token" %]
    Tokenet kan inte användas för att avbryta en ändring av e-postadress.

  [% ELSIF error == "wrong_token_for_changing_passwd" %]
    [% title = "Fel token" %]
    Tokenet kan inte användas för att ändra lösenordet.

  [% ELSIF error == "wrong_token_for_confirming_email_change" %]
    [% title = "Fel token" %]
    Tokenet kan inte användas för att ändra e-postadressen.

  [% ELSIF error == "wrong_token_for_creating_account" %]
    [% title = "Fel token" %]
    Tokenet kan inte användas för att skapa ett användarkonto.

  [% ELSIF error == "xmlrpc_invalid_value" %]
    ”[% value FILTER html %]” är inte ett giltigt värde för ett
    &lt;[% type FILTER html %]&gt;-fält. Se XML-RPC-specifikationen
    för mer information.

  [% ELSIF error == "xmlrpc_illegal_content_type" %]
    När XML-RPC används kan du inte skicka data som
    [%+ content_type FILTER html %]. Tillåtna innehållstyper är
    [% constants.XMLRPC_CONTENT_TYPE_WHITELIST.join(', ') FILTER html %].

  [% ELSIF error == "zero_length_file" %]
    [% title = "Filen är tom" %]
    Filen du försöker bifoga är tom, finns inte eller så har du inte
    behörighet att läsa den.

  [% ELSIF error == "illegal_user_id" %]
    [% title = "Ogiltigt användar-ID" %]
    Användar-ID:t ”[% userid FILTER html %]” är inte ett giltigt heltal.

  [% ELSIF error == "extern_id_exists" %]
    [% title = "Kontot finns redan" %]
    Det finns redan ett konto
    [% IF existing_login_name %]
      ([% existing_login_name FILTER html %])
    [% END %]
    med externt inloggnings-ID ”[% extern_id FILTER html %]”.

  [% ELSE %]

    [%# Try to find hooked error messages %]
    [% error_message = Hook.process("errors") %]

    [% IF not error_message %]
      [% title = "Felsträngen hittades inte" %]
      Användarfelsträngen <code>[% error FILTER html %]</code> hittades inte.
      Skicka e-post till [% Param("maintainer") %] och beskriv stegen som
      ledde till meddelandet.
    [% ELSE %]
      [% error_message FILTER none %]
    [% END %]
  [% END %]
[% END %]

[%# We only want HTML error messages for ERROR_MODE_WEBPAGE %]
[% USE Bugzilla %]
[% IF Bugzilla.error_mode != constants.ERROR_MODE_WEBPAGE %]
  [% IF Bugzilla.usage_mode == constants.USAGE_MODE_BROWSER %]
    [% error_message FILTER none %]
  [% ELSE %]
    [% error_message FILTER txt %]
  [% END %]
  [% RETURN %]
[% END %]

[% UNLESS header_done %]
  [% PROCESS global/header.html.tmpl %]
[% END %]

[% PROCESS global/docslinks.html.tmpl
   docslinks      = docslinks
   admindocslinks = admindocslinks
%]

<div id="error_msg" class="throw_error">
  [% error_message FILTER none %]
</div>

<p id="post_err_msg">
  Tryck på <b>Tillbaka</b> och försök igen.
</p>

[%# If a saved search fails, people want the ability to edit or delete it. 
  # This is the best way of getting information about that possible saved
  # search from any error call location. %]

[% namedcmd = Bugzilla.cgi.param("namedcmd") %]
[% sharer_id = Bugzilla.cgi.param("sharer_id") %]
[% IF namedcmd AND error != "missing_query" 
               AND error != "saved_search_used_by_whines"
               AND !sharer_id %]
  <p>  
    Du kan också
    <a href="buglist.cgi?cmdtype=dorem&amp;remaction=forget&amp;namedcmd=
                  [% namedcmd FILTER uri %]">glömma</a>
                  
    [% FOREACH q = Bugzilla.user.queries %]
      [% IF q.name == namedcmd %]
        eller <a href="query.cgi?[% q.url FILTER html %]">redigera</a>
      [% END %]
    [% END %]
    
    den sparade sökningen ”[% namedcmd FILTER html %]”.
  </p>
[% END %]            

[% PROCESS global/footer.html.tmpl %]

[% BLOCK object_name %]
  [% IF class == "Bugzilla::Attachment" %]
    bilaga
  [% ELSIF class == "Bugzilla::User" %]
    användare
  [% ELSIF class == "Bugzilla::Classification" %]
    klassificering
  [% ELSIF class == "Bugzilla::Product" %]
    produkt
  [% ELSIF class == "Bugzilla::Component" %]
    komponent
  [% ELSIF class == "Bugzilla::Version" %]
    version
  [% ELSIF class == "Bugzilla::Milestone" %]
    milstolpe
  [% ELSIF class == "Bugzilla::Status" %]
    status
  [% ELSIF class == "Bugzilla::Flag" %]
    flagga
  [% ELSIF class == "Bugzilla::FlagType" %]
    flaggtyp
  [% ELSIF class == "Bugzilla::Field" %]
    field
  [% ELSIF class == "Bugzilla::Group" %]
    group
  [% ELSIF class == "Bugzilla::Keyword" %]
    keyword
  [% ELSIF class == "Bugzilla::Search::Recent" %]
    recent search
  [% ELSIF class == "Bugzilla::Search::Saved" %]
    saved search
  [% ELSIF ( matches = class.match('^Bugzilla::Field::Choice::(.+)') ) %]
    [% SET field_name = matches.0 %]
    [% field_descs.$field_name FILTER html %]
  [% END %]
  [% Hook.process('end_object_name', 'global/user-error.html.tmpl') %]
[% END %]
