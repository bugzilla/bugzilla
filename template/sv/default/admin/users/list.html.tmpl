[% PROCESS global/header.html.tmpl
  title = "Välj användare"
  style_urls = ['skins/standard/admin.css']
  doc_section = "administering/users.html"
%]

[% PROCESS admin/users/listselectvars.html.tmpl
  listselectionvalues = listselectionvalues
%]

[% listselectionurlparams = INCLUDE listselectionurlparams %]

[% columns =
  [{name               => 'login_name'
    heading            => 'Redigera användare ...'
    contentlink        => 'editusers.cgi?action=edit&amp;userid=%%userid%%' _
                          listselectionurlparams
   }
   {name               => 'realname'
    heading            => 'Riktigt namn'
   }
   {name               => 'last_seen_date'
    heading            => 'Senaste inloggning'
   }
   {heading            => 'Kontohistorik'
    content            => 'Visa'
    contentlink        => 'editusers.cgi?action=activity' _
                                  '&amp;userid=%%userid%%' _
                                  listselectionurlparams
   }
  ]
%]

[% IF Param('allowuserdeletion') && editusers %]
  [% columns.push({heading     => 'Åtgärd'
                   content     => 'Ta bort'
                   contentlink => 'editusers.cgi?action=del' _
                                  '&amp;userid=%%userid%%' _
                                  listselectionurlparams
                  }
                 )
  %]
[% END %]

[% overrides.login_name = {} %]
[% overrides.realname = {} %]

[% FOREACH thisuser = users %]
  [% IF !thisuser.realname %]
    [% SET classes = (thisuser.is_enabled ? "warning" : "bz_inactive warning") %]
    [% overrides.realname.login_name.${thisuser.login_name} = {
           content          => "saknas"
           override_content => 1
           class            => classes
           override_class   => 1
       }
    %]
  [% ELSIF !thisuser.is_enabled %]
    [% overrides.realname.login_name.${thisuser.login_name} = {
           class          => "bz_inactive"
           override_class => 1
       }
    %]
  [% END %]

  [% IF !thisuser.is_enabled %]
    [% overrides.login_name.login_name.${thisuser.login_name} = {
           class          => "bz_inactive"
           override_class => 1
       }
    %]
  [% END %]
[% END %]

<p>[% users.size %] användare hittades.</p>

[% PROCESS admin/table.html.tmpl
  columns = columns
  data    = users
  overrides = overrides
%]

<p>
  Om du inte vill ändra ett användarkonto just nu kan du
  <a href="editusers.cgi">hitta andra användare</a>
  [% IF editusers %]
    eller
    <a href="editusers.cgi?action=add[% INCLUDE listselectionurlparams %]">lägga
    till en ny användare</a>
  [% END %].
</p>

[% PROCESS global/footer.html.tmpl %]
