[% PROCESS global/header.html.tmpl
  title = "Välj nyckelord"
  style_urls = ['skins/standard/admin.css']
%]

[% columns = [
     {
       name => "name"
       heading => "Redigera nyckelord ..."
       contentlink => "editkeywords.cgi?action=edit&amp;id=%%id%%"
     },
     {
       name => "description"
       heading => "Beskrivning"
       allow_html_content => 1
     },
     {
       name => "bug_count"
       heading => "$terms.Bugs"
       class => "right"
       contentlink => "buglist.cgi?keywords=%%name%%"
     },
     {
       heading => "Åtgärd"
       content => "Radera"
       contentlink => "editkeywords.cgi?action=del&amp;id=%%id%%"
     }
   ]
%]

[% PROCESS admin/table.html.tmpl
     columns = columns
     data = keywords
     footer = footer_row
%]

<p><a href="editkeywords.cgi?action=add">Lägg till ett nytt nyckelord</a></p>

[% PROCESS global/footer.html.tmpl %]
