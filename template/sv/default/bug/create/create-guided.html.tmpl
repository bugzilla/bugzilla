[%# INTERFACE:
  # This template has the same interface as create.html.tmpl
  #%]

[% USE Bugzilla %]
[% cgi = Bugzilla.cgi %]

[% PROCESS global/header.html.tmpl
   title = "Rapportera $terms.ABug"
   onload = "PutDescription()"
   style_urls = ['skins/standard/bug.css']
 %]

[%# This script displays the descriptions for selected components. %]
<script type="text/javascript">
var descriptions = [
[% FOREACH c = product.components %]
  [% NEXT IF NOT c.is_active %]
  '[% c.description FILTER js %]',
[% END %]
];

function PutDescription() {
  var description = document.getElementById('description');
  var componentIndex = document.getElementById('component').selectedIndex;
  YAHOO.util.Dom.removeClass("description", "bz_default_hidden");
  if (componentIndex != -1) {
    description.innerHTML = descriptions[componentIndex];
  }
}
</script>

<h3 id="step1">Steg 1 av 3: Har din [% terms.bug %] redan rapporterats?</h3>

<p class="warning">
  Hoppa inte över detta steg. Hälften av alla rapporterade [% terms.bugs %]
  finns redan.
</p>

<p>Kontrollera de två listorna över ofta rapporterade [% terms.bugs %]:</p>

<p>
  <a href="duplicates.cgi?product=[% product.name FILTER uri %]&amp;format=simple"
     target="somebugs">Topp 100 genom tiderna</a> (visas först) |
  <a href="duplicates.cgi?product=[% product.name FILTER uri %]&amp;format=simple&amp;sortby=delta&amp;reverse=1&amp;maxrows=100&amp;changedsince=14"
     target="somebugs">Vanliga de senaste två veckorna</a>
</p>

<iframe name="somebugs" id="somebugs"
  src="duplicates.cgi?product=[% product.name FILTER uri %]&amp;format=simple">
</iframe>

<p>
    Om din [% terms.bug %] inte finns där söker du i [% terms.Bugzilla %] genom att
    skriva några nyckelord om den i rutan. Exempel: <kbd><b>pop3 mail</b></kbd>
    eller <kbd><b>copy paste</b></kbd>. Resultaten visas ovan.
</p>

[%# All bugs opened inside the past six months %]
  <form action="buglist.cgi" method="get" target="somebugs">
    <input type="hidden" name="format" value="simple">
    <input type="hidden" name="order" value="relevance desc">
    <input type="hidden" name="bug_status" value="__all__">
    <input type="hidden" name="product" value="[% product.name FILTER html %]">
    <input type="hidden" name="chfieldfrom" value="-6m">
    <input type="hidden" name="chfieldto" value="Now">
    <input type="hidden" name="chfield" value="[Bug creation]">
    <input type="text" name="content" size="40">
    <input type="submit" id="search" value="Sök">
  </form>

<p>
  Gå igenom sökresultaten. Meddelandet <kbd><b>[% terms.zeroSearchResults %]</b></kbd>
  innebär att [% terms.Bugzilla %] inte hittade några matchande [% terms.bugs %].
  Kontrollera stavningen eller prova färre eller andra nyckelord. Om du hittar
  [% terms.abug %] som verkar vara samma, lägg till användbar extra information där
  i stället för att rapportera en ny.
</p>


<h3 id="step2">Steg 2 av 3: Ange information</h3>

<p>
  Om du har provat några sökningar och din [% terms.bug %] verkligen inte finns där,
  berätta allt om den.
</p>

<form id="guided_form" method="post" action="post_bug.cgi">
  <input type="hidden" name="format" value="guided">
  <input type="hidden" name="assigned_to" value="">
  <input type="hidden" name="priority"
         value="[% default.priority FILTER html %]">
  <input type="hidden" name="version"
         value="[% default.version FILTER html %]">
  <input type="hidden" name="token" value="[% token FILTER html %]">

<table>
  <tr class="guided_form_field">
    <th>Produkt</th>
    <td>
      <input type="hidden" name="product" value="[% product.name FILTER html %]">
      [% product.name FILTER html %]
    </td>
  </tr>

  <tr>
    <th>Komponent</th>
    <td>
      <select name="component" id="component" size="5" onchange="PutDescription()">
        [% IF NOT default.component_ %]
          [% default.component_ = "General" %]
        [% END %]
        [% FOREACH c = product.components %]
          [% NEXT IF NOT c.is_active %]
          <option value="[% c.name FILTER html %]"
                  [%+ 'selected="selected"' IF c.name == default.component_ %]>
            [% c.name FILTER html %]
          </option>
        [% END %]
      </select>

      <div id="description" class="comment bz_default_hidden">
        Välj en komponent för att visa dess beskrivning här.
      </div>

      <p>
        Området där problemet uppstår. För att välja rätt komponent kan du använda
        samma som för liknande [% terms.bugs %] i sökresultatet, eller läsa hela listan över
        <a href="describecomponents.cgi?product=[% product.name FILTER uri %]"
           target="_blank" >komponentbeskrivningar</a> (öppnas i nytt fönster) om du
        behöver mer hjälp.
      </p>
    </td>
  </tr>

  [%# We override rep_platform and op_sys for simplicity. %]
  [% rep_platform = [ "PC", "Macintosh", "Alla", "Övrigt" ] %]

  <tr class="guided_form_field">
    <th>[% field_descs.rep_platform FILTER html %]</th>
    <td>
      [% PROCESS select sel = 'rep_platform' %]
    </td>
  </tr>

  [% op_sys = [ "Windows XP", "Windows Vista", "Windows 7", "Windows 8",
                "Mac OS X", "Linux", "Alla", "Övrigt" ] %]

  <tr>
    <th>Operativsystem</th>
    <td>
      [% PROCESS select sel = 'op_sys' %]
    </td>
  </tr>

  [%# Accept URL parameter build ID for non-browser products %]
  [% IF cgi.param("buildid") %]
    [% buildid = cgi.param("buildid") %]
  [% END %]

  <tr class="guided_form_field">
    <th>Byggidentifierare</th>
    <td>
      <input type="text" size="80" name="buildid" value="[% buildid FILTER html %]">
      <p>
        Detta ska identifiera den exakta version av produkten som du använde.
        Om fältet ovan är tomt eller felaktigt kopierar du versionstexten från produktens
        meny Hjälp | Om (för webbläsare börjar den med ”Mozilla/5.0…”). Om produkten inte
        startar klistrar du i stället in den fullständiga URL som du läste in den från.
      </p>
    </td>
  </tr>

  <tr>
    <th>URL</th>
    <td>
      <input type="text" size="80" name="bug_file_loc" value="http://">
      <p>
        URL som visar problemet du ser (valfritt).
      </p>
   </td>
  </tr>

  <tr class="guided_form_field">
    <th>Sammanfattning</th>
    <td>
      <input type="text" size="80" name="short_desc" id="short_desc" 
             maxlength="255" spellcheck="true">
      <p>
        En mening som sammanfattar problemet. Var beskrivande och använd många nyckelord.
      </p>
      <p>
        <kbd>
          <span class="bad">Dåligt exempel</span>: e-post kraschade
        </kbd>
        <br>
        <kbd>
          <span class="good">Bra exempel</span>:
          krasch när jag stänger e-postfönstret under kontroll av ny POP-e-post
        </kbd>
      </p>
    </td>
  </tr>

  <tr>
    <th>Detaljer</th>
    <td>
      [% INCLUDE global/textarea.html.tmpl
        name      = 'comment'
        minrows   = 6
        cols      = constants.COMMENT_COLS
        mandatory = 1
      %]
      <p>
        Utveckla sammanfattningen. Beskriv så specifikt som möjligt vad som är fel.
      </p>
      <p>
        <kbd>
          <span class="bad">Dåligt exempel</span>: Mozilla kraschade.
          Det suger!
        </kbd>
        <br>
        <kbd>
          <span class="good">Bra exempel</span>: Efter en krasch som uppstod när jag
          sorterade i bokmärkeshanteraren<br> finns inte längre mina bokmärkesmappar på
          högsta nivån som börjar med bokstäverna Q till Z.
        </kbd>
      </p>
    </td>
  </tr>

  <tr class="guided_form_field">
    <th>Återskapbarhet</th>
    <td>
      <select name="reproducible">
        <option name="AlwaysReproducible" value="Always">
          Inträffar varje gång.
        </option>
        <option name="Sometimes" value="Sometimes">
          Inträffar ibland, men inte alltid.
        </option>
        <option name="DidntTry" value="Didn't try">
          Har inte försökt återskapa det.
        </option>
        <option name="NotReproducible" value="Couldn't Reproduce">
          Har försökt, men kunde inte återskapa det.
        </option>
      </select>
    </td>
  </tr>

  <tr>
    <th>Steg för att återskapa</th>
    <td>
      [% INCLUDE global/textarea.html.tmpl
        name           = 'reproduce_steps'
        minrows        = 4
        cols           = constants.COMMENT_COLS
        defaultcontent = "1.\n2.\n3."
      %]
      <p>
        Beskriv hur problemet kan återskapas, steg för steg. Ta med eventuella
        särskilda förberedelser.
      </p>
    </td>
  </tr>

  <tr class="guided_form_field">
    <th>Faktiskt resultat</th>
    <td>
      [% INCLUDE global/textarea.html.tmpl
        name    = 'actual_results'
        minrows = 4
        cols    = constants.COMMENT_COLS
      %]
      <p>
        Vad hände när du följde stegen ovan?
      </p>
    </td>
  </tr>

  <tr>
    <th>Förväntat resultat</th>
    <td>
      [% INCLUDE global/textarea.html.tmpl
        name    = 'expected_results'
        minrows = 4
        cols    = constants.COMMENT_COLS
      %]
      <p>
        Vad skulle programvaran ha gjort i stället?
      </p>
    </td>
  </tr>

  <tr class="guided_form_field">
    <th>Ytterligare information</th>
    <td>
      [% INCLUDE global/textarea.html.tmpl
        name    = 'additional_info'
        minrows = 8
        cols    = constants.COMMENT_COLS
      %]
      <p>
        Lägg till ytterligare information som kan vara relevant för [% terms.bug %],
        exempelvis vilket <b>tema</b> du använde (uppstår [% terms.bug %] även med
        standardtemat?) eller särskilda uppgifter om <b>din dators konfiguration</b>.
        Information som är längre än några rader, till exempel en <b>stackspårning</b>
        eller ett <b>HTML-testfall</b>, lägger du till med länken ”Lägg till bilaga”
        på [% terms.bug %] efter rapporteringen. Om det är relevant, ta även med
        byggkonfigurationen, som du får genom att skriva <kbd>about:buildconfig</kbd>
        i adressfältet.
        <br>
        <br>
        Om du rapporterar en krasch anger du den modul där programvaran kraschade
        (till exempel <kbd>Application Violation in gkhtml.dll</kbd>).
      </p>
    </td>
  </tr>

  <tr>
    <th>[% field_descs.bug_severity FILTER html %]</th>
    <td>
      <select name="bug_severity">
        <option name="critical" value="critical">
          Kritisk: Programvaran kraschar, hänger sig eller gör att du förlorar data.
        </option>
        <option name="major" value="major">
          Stor: En viktig funktion fungerar inte.
        </option>
        <option name="normal" value="normal" selected="selected">
          Normal: Det är [% terms.abug %] som bör åtgärdas.
        </option>
        <option name="minor" value="minor">
          Mindre: Mindre funktionsbortfall och det finns en enkel tillfällig lösning.
        </option>
        <option name="trivial" value="trivial">
          Trivial: Ett kosmetiskt problem, som ett felstavat ord eller feljusterad text.
        </option>
        <option name="enhancement" value="enhancement">
          Förbättring: Begäran om en ny funktion eller förbättring.
        </option>
      </select>
      <p>
        Ange hur allvarligt problemet är, eller om [% terms.bug %] är en begäran om en ny funktion.
      </p>
    </td>
  </tr>

  [% Hook.process('form') %]
</table>


<h3 id="step3">Steg 3 av 3: Skicka in rapporten om [% terms.bug %]</h3>

<p>
  <input type="submit" id="report" value="Skicka in rapport om [% terms.Bug %]">
</p>

<p>
  Klart! Tack så mycket. Du får e-post när arbetet med att åtgärda [% terms.bug %]
  går framåt.

<p>  
  Observera att vi får många rapporter om [% terms.bugs %], så det kan ta ett tag
  innan din hanteras. Du underlättar arbetet genom att se till att [%+ terms.bug %]
  är fullständig och lätt att förstå samt svara snabbt på frågor som kommer via e-post.
</p>

    </form>

[% PROCESS global/footer.html.tmpl %]

[%############################################################################%]
[%# Block for SELECT fields                                                  #%]
[%############################################################################%]

[% BLOCK select %]
  <select name="[% sel %]">
    [%- IF default.$sel %]
      <option value="[% default.$sel FILTER html %]" selected="selected">
        [% default.$sel FILTER html -%]
      </option>
    [% END %]
    [%- FOREACH x = $sel %]
      [% NEXT IF x == default.$sel %]
      <option value="[% x FILTER html %]">
        [% x FILTER html -%]
      </option>
    [%- END %]
  </select>
[% END %]
