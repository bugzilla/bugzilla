[% PROCESS global/header.html.tmpl
  title = "Radera klassificering"
  style_urls = ['skins/standard/admin.css']
%]

<table id="admin_table">
  <tr class="column_header">
    <th>Fält</th>
    <th>Värde</th>
  </tr>
  <tr>
    <td>Klassificering</td>
    <td>[% classification.name FILTER html %]</td>
  </tr>
  <tr>
    <td>Beskrivning</td>
    <td>
      [% IF classification.description %]
        [% classification.description FILTER html_light %]
      [% ELSE %]
        <span class="warning">beskrivning saknas</span>
      [% END %]
    </td>
  </tr>
  <tr>
    <td>Sorteringsnyckel</td>
    <td>[% classification.sortkey FILTER html %]</td>
  </tr>
</table>

<h2>Bekräftelse</h2>

<p>Vill du verkligen radera denna klassificering?</p>
<form method=post action="editclassifications.cgi">
  <input type=submit value="Ja, radera">
  <input type=hidden name="action" value="delete">
  <input type=hidden name="classification" value="[% classification.name FILTER html %]">
  <input type="hidden" name="token" value="[% token FILTER html %]">
</form>

[% PROCESS admin/classifications/footer.html.tmpl %]

[% PROCESS global/footer.html.tmpl %]
