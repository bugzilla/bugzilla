[% title = BLOCK %]Ta bort version av produkten ”[% product.name FILTER html %]”[% END %]

[% PROCESS global/header.html.tmpl title = title style_urls = ['skins/standard/admin.css'] %]

<table id="admin_table">
  <tr class="column_header"><th>Fält</th><th>Värde</th></tr>
  <tr><td>Version</td><td>[% version.name FILTER html %]</td></tr>
  <tr><td>Version av produkt</td><td>[% product.name FILTER html %]</td></tr>
  <tr><td>[% terms.Bugs %]</td><td>
      [% IF version.bug_count %]
        <a title="Lista över [% terms.bugs %] riktade mot versionen ”[% version.name FILTER html %]”"
           href="buglist.cgi?version=[% version.name FILTER uri %]&amp;product=[%- product.name FILTER uri %]">[%- version.bug_count FILTER none %]</a>
      [% ELSE %]Inga[% END %]
  </td></tr>
</table>

<h2>Bekräftelse</h2>

[% IF version.bug_count %]
  <p class="confirmation">
  Tyvärr finns det
  [% IF version.bug_count > 1 %]
    [% version.bug_count FILTER none %] öppna [% terms.bugs %]
  [% ELSE %]
    ett öppet [% terms.bug %]
  [% END %]
  för den här versionen. Flytta
  [% IF version.bug_count > 1 %]dessa [% terms.bugs %][% ELSE %]detta [% terms.bug %][% END %]
  till en annan version innan versionen kan tas bort.
  </p>
[% ELSE %]
  <p>Vill du verkligen ta bort den här versionen?</p>
  <form method="post" action="editversions.cgi">
    <input type="submit" id="delete" value="Ja, ta bort">
    <input type="hidden" name="action" value="delete">
    <input type="hidden" name="product" value="[% product.name FILTER html %]">
    <input type="hidden" name="version" value="[% version.name FILTER html %]">
    <input type="hidden" name="token" value="[% token FILTER html %]">
  </form>
[% END %]

[% PROCESS admin/versions/footer.html.tmpl %]
[% PROCESS global/footer.html.tmpl %]
