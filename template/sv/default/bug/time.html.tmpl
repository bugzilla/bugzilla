[% BLOCK formattimeunit %]
  [% time_unit = time_unit FILTER format('%.2f') %]
  [% time_unit.replace('0\Z', '') %]
[% END %]

[% BLOCK calculatepercentage %]
  [% IF (act + rem) > 0 %]
    [% (act / (act + rem)) * 100
       FILTER format("%d") %]
  [% ELSE %]
    0
  [% END %]
[% END %]
