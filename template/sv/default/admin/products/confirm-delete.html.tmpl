[%# INTERFACE:
  # product: Bugzilla::Product object; The product
  #
  # (classification fields available if Param('useclassification') is enabled:)
  #
  # classification: Bugzilla::Classification object; The classification 
  #                                                  the product is in
  #
  #%]

[% title = BLOCK %]Ta bort produkten '[% product.name FILTER html %]'
[% END %]

[% PROCESS global/header.html.tmpl
  title = title
  style_urls = ['skins/standard/admin.css']
%]

<table id="admin_table">
  <tr class="column_header">
    <th>Fält</th>
    <th>Värde</th>
  </tr>

  [% IF Param('useclassification') %]
    <tr>
      <td>Klassificering</td>
      <td>[% classification.name FILTER html %]</td>
    </tr>
    <tr>
      <td>Beskrivning av klassificering</td>
      <td>
        [% IF classification.description %]
          [% classification.description FILTER html_light %]
        [% ELSE %]
          <span class="warning">saknas</span>
        [% END %]
      </td>
    </tr>
  [% END %]

  <tr>
    <td>Produkt</td>
    <td>
      <a href="editproducts.cgi?product=[% product.name FILTER uri %]">
        [% product.name FILTER html %]
      </a>
    </td>
  </tr>
  <tr>
    <td>Beskrivning</td>
    <td>[% product.description FILTER html_light %]</td>
  </tr>

  [% IF Param('usetargetmilestone') %]
    <tr>
      <td>Webbadress för milstolpe</td>
      <td>
        [% IF product.milestone_url %]
          <a href="[% product.milestone_url FILTER html %]">
            [%- product.milestone_url FILTER html %]
          </a>
        [% ELSE %]
          inga
        [% END %]
      </td>
    </tr>
  [% END %]

  <tr>
    <td>Stängd för [% terms.bugs %]</td>
    <td>
      [% IF product.is_active %]
        öppen
      [% ELSE %]
        stängd
      [% END %]
    </td>
  </tr>

  <tr>
    <td>
      [% IF product.components.size > 0 %]
        <a href="editcomponents.cgi?product=[% product.name FILTER uri %]"
           title="Redigera komponenter för produkten '[% product.name FILTER html %]'">
          Komponenter
        </a>
      [% ELSE %]
        Komponenter
      [% END %]
    </td>
    <td>
      [% IF product.components.size > 0 %]
        <table class="no-border">
          [% FOREACH c = product.components %]
            <tr>
              <th>[% c.name FILTER html %]:</th>
              <td>[% c.description FILTER html_light %]</td>
            </tr>
          [% END %]
        </table>
      [% ELSE %]
        inga
      [% END %]
    </td>
  </tr>

  <tr>
    <td>
      [% IF product.versions.size > 0 %]
        <a href="editversions.cgi?product=[%- product.name FILTER uri %]">
          Versioner
        </a>
      [% ELSE %]
        Versioner
      [% END %]
    </td>
    <td>
      [% IF product.versions.size > 0 %]
        <div class="multi-columns">
          [% FOREACH v = product.versions %]
            [% v.name FILTER html %]<br>
          [% END %]
        </div>
      [% ELSE %]
        inga
      [% END %]
    </td>
  </tr>


  [% IF Param('usetargetmilestone') %]
    <tr>
      <td>
        [% IF product.milestones.size > 0 %]
          <a href="editmilestones.cgi?product=[%- product.name FILTER uri %]">
            Milstolpar
          </a>
        [% ELSE %]
          Milstolpar
        [% END %]
      </td>
      <td>
        [% IF product.milestones.size > 0 %]
          <div class="multi-columns">
            [% FOREACH m = product.milestones %]
              [% m.name FILTER html %]<br>
            [% END %]
          </div>
        [% ELSE %]
          inga
        [% END %]
      </td>
    </tr>
  [% END %]

  <tr>
    <td>[% terms.Bugs %]</td>
    <td>
      [% IF product.bug_count %]
        <a href="buglist.cgi?product=[% product.name FILTER uri %]"
           title="Lista över [% terms.bugs %] för produkten '[% product.name FILTER html %]'">
          [% product.bug_count FILTER html %]
        </a>
      [% ELSE %]
        inga
      [% END %]
    </td>
  </tr>
</table>

<h2>Bekräftelse</h2>

[% IF product.bug_count %]

  [% IF !Param("allowbugdeletion") %]

    <p class="confirmation">
      Det finns
      [% IF product.bug_count > 1 %]
        [% product.bug_count FILTER html %] [%+ terms.bugs %]
      [% ELSE %]
        1 [% terms.bug %]
      [% END %]
      kvar för den här produkten. Du måste tilldela om
      [% IF product.bug_count > 1 %]
        dessa [% terms.bugs %]
      [% ELSE %]
        den här [% terms.bug %]
      [% END %]
      till en annan produkt innan du kan ta bort den här.
    </p>

  [% ELSE %]

    <p class="confirmation">
      Det finns
      [% IF product.bug_count > 1 %]
        [% product.bug_count FILTER html %] [%+ terms.bugs %]
      [% ELSE %]
        1 [% terms.bug %]
      [% END %]
      registrerade för den här produkten. När du tar bort produkten tas <b>ALLA</b>
      lagrade [% terms.bugs %] och deras historik också bort.
    </p>

  [% END %]

[% END %]

[% Hook.process("confirmation") %]

[% IF product.bug_count == 0 || Param('allowbugdeletion') %]

  <p>Vill du verkligen ta bort den här produkten?</p>

  <form method="post" action="editproducts.cgi">
    <input type="checkbox" id="delete_series" name="delete_series" value=1>
    <label for="delete_series">
      Ta bort alla relaterade serier. Du kan även ta bort dem senare på
      <a href="chart.cgi?category=[% product.name FILTER html %]">sidan för nya diagram</a>.
    </label><p>
    <input type="submit" id="delete" value="Ja, ta bort">
    <input type="hidden" name="action" value="delete">
    <input type="hidden" name="product" value="[% product.name FILTER html %]">
    <input type="hidden" name="token" value="[% token FILTER html %]">
  </form>

[% END %]

[% PROCESS admin/products/footer.html.tmpl %]

[% PROCESS global/footer.html.tmpl %]
