[% title = BLOCK %]Ta bort komponenten ”[% comp.name FILTER html %]”
från produkten ”[% product.name FILTER html %]”
  [% END %]

[% PROCESS global/header.html.tmpl
  title = title
  style_urls = ['skins/standard/admin.css']
%]

<table id="admin_table">
  <tr class="column_header">
    <th>Fält</th>
    <th>Värde</th>
  </tr>
  <tr>
    <td>Komponent</td>
    <td>[% comp.name FILTER html %]</td>
  </tr>
  <tr>
    <td>Komponentbeskrivning</td>
    <td>[% comp.description FILTER html_light %]</td>
  </tr>
  <tr>
    <td>Standardtilldelad</td>
    <td>[% comp.default_assignee.login FILTER html %]</td>
  </tr>

  [% IF Param('useqacontact') %]
    <tr>
      <td>Standard-QA-kontakt</td>
      <td>[% comp.default_qa_contact.login FILTER html %]</td>
    </tr>
  [% END %]

  <tr>
    <td>Komponent i produkt</td>
    <td>[% product.name FILTER html %]</td>
  </tr>

  [% IF product.description %]
    <tr>
      <td>Produktbeskrivning</td>
      <td>[% product.description FILTER html_light %]</td>
    </tr>
  [% END %]

  [% IF Param('usetargetmilestone') %]
    <tr>
      <td>Webbadress till produktens milstolpe</td>
      <td>
        <a href="[% product.milestone_url FILTER html %]">
          [% product.milestone_url FILTER html %]</a>
      </td>
    </tr>
  [% END %]

  <tr>
    <td>Öppen för [% terms.bugs %]</td>
    <td>[% IF product.is_active && comp.isactive %]Ja[% ELSE %]Nej[% END %]</td>
  </tr>
  <tr>
    <td>[% terms.Bugs %]</td>
    <td>
      [% IF comp.bug_count %]
        <a title="Lista över [% terms.bugs %] för komponenten ”[% comp.name FILTER html %]”"
           href="buglist.cgi?component=[% comp.name FILTER uri %]&amp;product=
                 [%- product.name FILTER uri %]">[% comp.bug_count %]</a>
      [% ELSE %]
        Inga
      [% END %]
    </td>
  </tr>
</table>

<h2>Bekräftelse</h2>

[% IF comp.bug_count %]

  [% IF !Param("allowbugdeletion") %]
    <p class="confirmation">
      Det finns
      [% IF comp.bug_count > 1 %]
        [% comp.bug_count %] [%+ terms.bugs %]
      [% ELSE %]
        1 [% terms.bug %]
      [% END %]
      för den här komponenten. Du måste tilldela

      [% IF comp.bug_count > 1 %]
        dessa [% terms.bugs %]
      [% ELSE %]
        [% terms.abug %]
      [% END %]
      till en annan komponent innan du kan ta bort den här.
    </p>
  [% ELSE %]
    <p class="confirmation">
      Det finns
      [% IF comp.bug_count > 1 %]
        [% comp.bug_count %] [%+ terms.bugs %]
      [% ELSE %]
        1 [% terms.bug %]
      [% END %]
      för den här komponenten. När du tar bort komponenten tas <b>ALLA</b>
      sparade [% terms.bugs %] och deras historik också bort.
    </p>
  [% END %]

[% END %]

[% IF comp.bug_count == 0 || Param('allowbugdeletion') %]

  <p>Vill du verkligen ta bort den här komponenten?</p>

  <form method="post" action="editcomponents.cgi">
  <input type="submit" id="delete" value="Ja, ta bort">
  <input type="hidden" name="action" value="delete">
  <input type="hidden" name="product" value="[% product.name FILTER html %]">
  <input type="hidden" name="component" value="[% comp.name FILTER html %]">
  <input type="hidden" name="token" value="[% token FILTER html %]">
  </form>

[% END %]

[% PROCESS admin/components/footer.html.tmpl %]

[% PROCESS global/footer.html.tmpl %]
