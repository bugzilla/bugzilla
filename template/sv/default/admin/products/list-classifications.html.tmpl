[% PROCESS global/header.html.tmpl
  title = "Välj klassificering"
  style_urls = ['skins/standard/admin.css']
%]

[% columns = [
     {
       name => "name"
       heading => "Redigera produkter i ..."
       contentlink => 'editproducts.cgi?classification=%%name%%'
     },
     {
       name => "description"
       heading => "Beskrivning"
       allow_html_content => 1
     },
     {
       name => "product_count"
       class => "right"
       heading => "Antal produkter"
     }
   ]
%]

[% IF user.in_group('editcomponents') %]
  [% columns.push({
       heading => "Åtgärd ..."
       content => "Lägg till produkt"
       contentlink => 'editproducts.cgi?action=add&amp;classification=%%name%%' })
  %]
[% END %]

[% Hook.process('before_table') %]

[% PROCESS admin/table.html.tmpl
     columns = columns
     data = classifications
%]

[% PROCESS global/footer.html.tmpl %]
