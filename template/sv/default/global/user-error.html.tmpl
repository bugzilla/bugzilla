[%# INTERFACE:
  # header_done: boolean. True if the Bugzilla header has already been printed.
  # error: string. The tag of the error, or the error message to be displayed
  # (deprecated). May contain HTML if it's an error message.
  #%]

[%# This is a list of all the possible user errors. Please keep them in
  # alphabetical order by error tag, and leave a blank line between errors.
  #
  # Note that you must explicitly filter every single template variable
  # in this file; if you do not wish to change it, use the "none" filter.
  #
  # Extension- or custom-specific error handling  can be easily added 
  # via hooks: just place additional code into
  # template/en/hook/global/user-error-errors.html.tmpl
  # Note: be aware of uniqueness of error string parameter value, since
  # nobody can guarantee the hook files processing order in the future.
  #%]

[% PROCESS "global/field-descs.none.tmpl" %]

[% DEFAULT title = "Fel" %]

[% error_message = BLOCK %]
  [% IF    error == "account_creation_disabled" %]
    [% title = "Det går inte att skapa konton" %]
    Det går inte att skapa användarkonton.
    <hr>
    Nya konton måste skapas av en administratör. Ansvarig är
    [% Param("maintainer") %].

  [% ELSIF error == "account_creation_restricted" %]
    [% title = "Begränsat skapande av konton" %]
    Skapandet av användarkonton är begränsat.
    <hr>
    Kontakta administratören eller den ansvariga
    ([% Param("maintainer") %]) för information om hur
    du skapar ett konto.

  [% ELSIF error == "account_disabled" %]
    [% title = "Kontot är inaktiverat" %]
    [% disabled_reason FILTER none %]
    <hr>
    Om du anser att ditt konto bör återställas, skicka e-post till
    [% Param("maintainer") %] och förklara varför.

  [% ELSIF error == "account_exists" %]
    [% title = "Kontot finns redan" %]
    Det finns redan ett konto med
    [% IF email %]
      inloggningsnamnet [% email FILTER html %].
    [% ELSE %]
      det inloggningsnamnet.
    [% END %]

  [% ELSIF error == "account_locked" %]
    [% title = "Kontot är låst" %]
    Din IP-adress ([% ip_addr FILTER html %]) har låsts ute från
    kontot till [% unlock_at FILTER time %], eftersom du har
    överskridit det högsta antalet inloggningsförsök.

  [% ELSIF error == "alias_has_comma_or_space" %]
    [% title = "Ogiltiga tecken i alias" %]
    Aliaset <em>[% alias FILTER html %]</em> innehåller ett eller flera
    kommatecken eller blanksteg. Alias får inte innehålla kommatecken eller
    blanksteg eftersom dessa tecken används för att skilja alias åt i listor.
    Välj ett alias utan kommatecken och blanksteg.

  [% ELSIF error == "alias_in_use" %]
    [% title = "Aliaset används redan" %]
    [% IF user.can_see_bug(bug_id) %]
      [% terms.Bug %] [%+ bug_id FILTER bug_link(bug_id) FILTER none %]
    [% ELSE %]
      En annan [% terms.bug %]
    [% END %]
    använder redan aliaset <em>[% alias FILTER html %]</em>.
    Välj ett annat alias.

  [% ELSIF error == "alias_is_numeric" %]
    [% title = "Aliaset är numeriskt" %]
    Du försökte ge [% terms.bug %] aliaset <em>[% alias FILTER html %]</em>,
    men alias kan inte enbart bestå av siffror eftersom de då
    kan förväxlas med [% terms.bug %]-ID:n. Välj ett alias
    som innehåller minst en bokstav.

  [% ELSIF error == "alias_too_long" %]
    [% title = "Aliaset är för långt" %]
    Alias för [% terms.Bug %] får inte vara längre än 40 tecken.
    Välj ett kortare alias.

  [% ELSIF error == "api_key_not_valid" %]
    [% title = "Ogiltig API-nyckel" %]
    API-nyckeln du angav är ogiltig. Kontrollera att du skrev in den
    rätt.

  [% ELSIF error == "api_key_revoked" %]
    [% title = "Ogiltig API-nyckel" %]
    API-nyckeln du angav har återkallats av användaren som skapade den.

  [% ELSIF error == "attachment_bug_id_mismatch" %]
    [% title = "Ogiltiga bilagor" %]
    Du försökte utföra en åtgärd på bilagor från olika [% terms.bugs %].
    Åtgärden kräver att alla bilagor hör till samma [% terms.bug %].

  [% ELSIF error == "auth_cant_create_account" %]
    [% title = "Det går inte att skapa konton" %]
    Den här webbplatsen använder en autentiseringsmetod som inte tillåter
    att konton skapas. Kontakta en administratör för att få ett nytt konto.

  [% ELSIF error == "auth_failure" %]
    [% title = "Behörighet krävs" %]
    [% admindocslinks = {'groups.html#groups' => 'Gruppsäkerhet'} %]
    Tyvärr
    [% IF group %]
      är du inte medlem i gruppen ”[% group FILTER html %]”,
    [% END %]

    [% IF reason %]
      [% IF group %] och [% END %]
      [% IF reason == "cant_bless" %]
        saknar du behörighet att lägga till eller ta bort personer från en grupp,
      [% ELSIF reason == "not_visible" %]
        finns det synlighetsbegränsningar för vissa användargrupper,
      [% END %]
    [% END %]

    [% IF group || reason %] och därför [% END %] har du inte behörighet att
    [% IF action == "access" %]
      komma åt
    [% ELSIF action == "add" %]
      lägga till nya
    [% ELSIF action == "begin" %]
      påbörja
    [% ELSIF action == "modify" %]
      ändra
    [% ELSIF action == "delete" %]
      ta bort
    [% ELSIF action == "edit" %]
      lägga till, ändra eller ta bort
    [% ELSIF action == "run" %]
      köra
    [% ELSIF action == "schedule" %]
      schemalägga
    [% ELSIF action == "search" %]
      söka i
    [% ELSIF action == "use" %]
      använda
    [% ELSIF action == "approve" %]
      godkänna
    [% ELSE %]
      [%+ Hook.process('auth_failure_action') %]
    [% END %]

    [% IF object == "administrative_pages" %]
      administrativa sidor
    [% ELSIF object == "attachment" %]
      [% IF attach_id %]
        bilaga #[% attach_id FILTER html %]
      [% ELSE %]
        den här bilagan
      [% END %]
    [% ELSIF object == "bugs" %]
      [%+ terms.bugs %]
    [% ELSIF object == "bug_fields" %]
      fältet [% field_descs.$field FILTER html %]
    [% ELSIF object == "charts" %]
      funktionen ”Nya diagram”
    [% ELSIF object == "classifications" %]
      klassificeringar
    [% ELSIF object == "components" %]
      komponenter
    [% ELSIF object == "comment_tags" %]
      kommentaretiketter
    [% ELSIF object == "custom_fields" %]
      anpassade fält
    [% ELSIF object == "field_values" %]
      fältvärden
    [% ELSIF object == "flagtypes" %]
      flaggtyper
    [% ELSIF object == "group_access" %]
      gruppåtkomst
    [% ELSIF object == "groups" %]
      grupper
    [% ELSIF object == "keywords" %]
      nyckelord
    [% ELSIF object == "milestones" %]
      milstolpar
    [% ELSIF object == "multiple_bugs" %]
      flera [% terms.bugs %] samtidigt
    [% ELSIF object == "parameters" %]
      parametrar
    [% ELSIF object == "products" %]
      produkter
    [% ELSIF object == "quips" %]
      citat
    [% ELSIF object == "reports" %]
      bevakningsrapporter
    [% ELSIF object == "sanity_check" %]
      en rimlighetskontroll
    [% ELSIF object == "settings" %]
      inställningar
    [% ELSIF object == "sudo_session" %]
      en sudo-session
    [% ELSIF object == "timetracking_summaries" %]
      sammanfattningsrapporter för tidsspårning
    [% ELSIF object == "user" %]  
      användaren [% IF userid %] med ID ”[% userid FILTER html %]”
      [% ELSE %]du angav [% END %]
    [% ELSIF object == "users" %]
      användare
    [% ELSIF object == "versions" %]
      versioner
    [% ELSIF object == "workflow" %]
      arbetsflödet
    [% ELSE %]
      [%+ Hook.process('auth_failure_object') %]
    [% END %].

    [% Hook.process("auth_failure") %]

  [% ELSIF error == "auth_invalid_token" %]
    [% title = "Ett tokenfel inträffade" %]
    Tokenet ”[% token FILTER html %]” är inte giltigt. Det kan bero på att
    du läste in sidan för mer än tre dagar sedan.

  [% ELSIF error == "auth_untrusted_request" %]
    [% title = "Otillförlitlig autentiseringsbegäran" %]
    Du försökte logga in med kontot <em>[% login FILTER html %]</em>, men
    [% terms.Bugzilla %] kan inte lita på din begäran. Kontrollera att
    webbläsaren accepterar kakor och att du inte har omdirigerats hit från en
    extern webbplats. <a href="index.cgi?GoAheadAndLogIn=1">Klicka här</a> om
    du ändå vill logga in.

  [% ELSIF error == "attachment_deletion_disabled" %]
    [% title = "Borttagning av bilagor är avstängd" %]
    Det går inte att ta bort bilagor i den här installationen.

  [% ELSIF error == "attachment_removed" %]
    [% title = "Bilagan har tagits bort" %]
    Bilagan du försöker komma åt har tagits bort.

  [% ELSIF error == "bad_page_cgi_id" %]
    [% title = "Ogiltigt sid-ID" %]
    ID:t <code>[% page_id FILTER html %]</code> är inte en
    giltig sididentifierare.

  [% ELSIF error == "bug_access_denied" %]
    [% title = "$terms.Bug: åtkomst nekad" %]
    [% admindocslinks = {'groups.html#groups' => 'Gruppsäkerhet'} %]
    Du har inte behörighet att komma åt [% terms.bug %] #[% bug_id FILTER html %].

  [% ELSIF error == "bug_access_query" %]
    [% title = "$terms.Bug: åtkomst nekad" %]
    [% docslinks = {'administering/users.html#creating-new-users' => 'Skapa ett konto'} %]
    Du har inte behörighet att komma åt [% terms.bug %] #[% bug_id FILTER html %].
    För att se [% terms.bug %] måste du först
    first <a href="show_bug.cgi?id=
                   [% bug_id FILTER uri %]&amp;GoAheadAndLogIn=1">logga
    in på ett konto</a> med rätt behörighet.

  [% ELSIF error == "bug_url_invalid" %]
    [% title = "Ogiltig URL till $terms.bug" %]
    <code>[% url FILTER html %]</code> är inte en giltig URL till [% terms.abug %].
    [% IF reason == 'http' %]
      URL:er måste börja med ”http” eller ”https”.
    [% ELSIF reason == 'path_only' %]
      Du måste ange en fullständig URL.
    [% ELSIF reason == 'id' %]
      Det finns inget giltigt ID för [% terms.bug %] i URL:en.
    [% ELSE %]
      URL:er i [%+ field_descs.see_also FILTER html %] ska peka på något av följande:
      <ul>
        <li><code>show_bug.cgi</code> i en Bugzilla-installation.</li>
        <li>En b[% %]ug på launchpad.net.</li>
        <li>Ett ärende på code.google.com.</li>
        <li>En b[% %]ug på b[% %]ugs.debian.org.</li>
        <li>Ett ärende i en JIRA-installation.</li>
        <li>En biljett i en Trac-installation.</li>
        <li>En b[% %]ug i en MantisBT-installation.</li>
        <li>En b[% %]ug på sourceforge.net.</li>
        <li>Ett ärende eller en pull-begäran på github.com.</li>
        [% Hook.process('bug_url_invalid_tracker') %]
      </ul>
    [% END %]

  [% ELSIF error == "bug_url_too_long" %]
    [% title = "Ogiltig URL till $terms.bug" %]
    URL:er till [% terms.Bug %] får inte vara längre än
    [%+ constants.MAX_BUG_URL_LENGTH FILTER none %] tecken.
    <code>[% url FILTER html %]</code> är för lång.

  [% ELSIF error == "buglist_parameters_required" %]
    [% title = "Parametrar krävs" %]
    [% docslinks = {'using/finding.html' => "Söka efter $terms.bugs",
                    'using/finding.html#bug-lists' => "Listor med $terms.bugs"} %]
    Du kan inte söka eller skapa sparade sökningar utan några sökvillkor.

  [% ELSIF error == "cc_remove_denied" %]
    [% title = "Ändring nekad" %]
    Du har inte behörighet att ta bort andra personer från CC-listan.

  [% ELSIF error == "chart_too_large" %]
    [% title = "Diagrammet är för stort" %]
    Ett diagram får högst vara 2 000 × 2 000.

  [% ELSIF error == "comment_id_invalid" %]
    [% id FILTER html %] är inte ett giltigt kommentar-ID.

  [% ELSIF error == "comment_invalid_isprivate" %]
    Du försökte ändra sekretessen för kommentaren med ID [% id FILTER html %],
    men den kommentaren är inte giltig för [% terms.bug %].

  [% ELSIF error == "comment_is_private" %]
    Kommentaren med ID [% id FILTER html %] är privat.

  [% ELSIF error == "comment_required" %]
    [% title = "Kommentar krävs" %]
    Du måste ange en
    [% IF old.defined && new.defined %]
      <b>kommentar</b> när du ändrar [% field_descs.$field FILTER html %]
      för [% terms.abug %] från [% (old || "(tomt)") FILTER html %]
      till [% (new || "(tomt)") FILTER html %].
    [% ELSIF new %]
      beskrivning för [% terms.bug %].
    [% ELSE %]
      <b>kommentar</b> till ändringen.
    [% END %]

  [% ELSIF error == "comment_too_long" %]
    [% title = "Kommentaren är för lång" %]
    Kommentarer får inte vara längre än
    [%+ constants.MAX_COMMENT_LENGTH FILTER html %] tecken.

  [% ELSIF error == "comment_tag_disabled" %]
    [% title = "Kommentaretiketter är avstängda" %]
    Kommentaretiketter är inte aktiverade.

  [% ELSIF error == "comment_tag_invalid" %]
    [% title = "Ogiltig kommentaretikett" %]
    Kommentaretiketten ”[% tag FILTER html %]” innehåller ogiltiga tecken eller
    ord.

  [% ELSIF error == "comment_tag_too_long" %]
    [% title = "Kommentaretiketten är för lång" %]
    Kommentaretiketter får inte vara längre än
    [%+ constants.MAX_COMMENT_TAG_LENGTH FILTER html %] tecken.

  [% ELSIF error == "comment_tag_too_short" %]
    [% title = "Kommentaretiketten är för kort" %]
    Kommentaretiketter måste innehålla minst
    [%+ constants.MIN_COMMENT_TAG_LENGTH FILTER html %] tecken.

  [% ELSIF error == "auth_classification_not_enabled" %]
    [% title = "Klassificering är inte aktiverad" %]
    Klassificering är inte aktiverad.

  [% ELSIF error == "classification_name_too_long" %]
    [% title = "Klassificeringsnamnet är för långt" %]
    Namnet på en klassificering är begränsat till [% constants.MAX_CLASSIFICATION_SIZE FILTER html %]
    tecken. ”[% name FILTER html %]” är för långt ([% name.length %] tecken).

[% ELSIF error == "classification_not_specified" %]
    [% title = "Du måste ange ett klassificeringsnamn" %]
    Du måste ange ett klassificeringsnamn.

  [% ELSIF error == "classification_already_exists" %]
    [% title = "Klassificeringen finns redan" %]
    En klassificering med namnet ”[% name FILTER html %]” finns redan.

  [% ELSIF error == "classification_invalid_sortkey" %]
    [% title = "Ogiltig sorteringsnyckel för klassificering" %]
    Sorteringsnyckeln ”[% sortkey FILTER html %]” är ogiltig. Den måste vara ett
    heltal mellan 0 och [% constants.MAX_SMALLINT FILTER html %].

  [% ELSIF error == "classification_not_deletable" %]
    [% title = "Standardklassificeringen kan inte tas bort" %]
    Du kan inte ta bort standardklassificeringen.

  [% ELSIF error == "classification_has_products" %]
     Det finns produkter för denna klassificering. Du
     måste tilldela produkterna till en annan klassificering innan du
     kan ta bort den här.

  [% ELSIF error == "component_already_exists" %]
    [% title = "Komponenten finns redan" %]
    Produkten <em>[% product.name FILTER html %]</em> har redan
    en komponent med namnet <em>[% name FILTER html %]</em>.

  [% ELSIF error == "component_blank_description" %]
    [% title = "Komponentbeskrivningen får inte vara tom" %]
    Du måste ange en beskrivning för komponenten.

  [% ELSIF error == "component_blank_name" %]
    [% title = "Komponentnamnet får inte vara tomt" %]
    Du måste ange ett namn för den nya komponenten.

  [% ELSIF error == "component_has_bugs" %]
    [% title = BLOCK %]Komponenten har [% terms.Bugs %][% END %]
    Det finns [% nb FILTER html %] [%+ terms.bugs %] för denna komponent.
    Du måste tilldela [% terms.bugs %] till en annan komponent innan du
    kan ta bort den här.

  [% ELSIF error == "component_is_last" %]
    [% title = BLOCK %]Sista komponenten i produkten[% END %]
    ”[% comp.name FILTER html %]” är den sista komponenten i
    produkten ”[% comp.product.name FILTER html %]”. Du kan inte ta bort den.

  [% ELSIF error == "component_name_too_long" %]
    [% title = "Komponentnamnet är för långt" %]
    Namnet på en komponent är begränsat till [% constants.MAX_COMPONENT_SIZE FILTER html %]
    tecken. ”[% name FILTER html %]” är för långt ([% name.length %] tecken).

  [% ELSIF error == "component_need_initialowner" %]
    [% title = "Komponenten kräver en standardtilldelad" %]
    Komponenten kräver en standardtilldelad.

  [% ELSIF error == "customfield_nonexistent" %]
    [% title = "Okänt anpassat fält" %]
    Det finns inget anpassat fält med namnet ”[% name FILTER html %]”.

  [% ELSIF error == "customfield_not_obsolete" %]
    [% title = "Det anpassade fältet är inte föråldrat" %]
    Det anpassade fältet ”[% name FILTER html %]” är inte föråldrat.
    Markera ett anpassat fält som föråldrat innan du försöker ta bort det.

  [% ELSIF error == "customfield_has_activity" %]
    [% title = "Det anpassade fältet har aktivitet" %]
    Det anpassade fältet ”[% name FILTER html %]” kan inte tas bort eftersom
    det har registrerad aktivitet.

  [% ELSIF error == "customfield_has_contents" %]
    [% title = "Det anpassade fältet har innehåll" %]
    Det anpassade fältet ”[% name FILTER html %]” kan inte tas bort eftersom
    minst en [% terms.bug %] har ett värde i fältet.

  [% ELSIF error == "dependency_loop_multi" %]
    [% title = "Beroendeslinga upptäckt" %]
    Följande [% terms.bug %] skulle visas i både delarna ”beror på”
    och ”blockerar” av beroendeträdet om dessa ändringar
    sparas:
    [% FOREACH dep = deps %]
      [%+ dep FILTER bug_link(dep) FILTER none %]
    [% END %].
    Det skulle skapa ett cirkulärt beroende, vilket inte är tillåtet.

  [% ELSIF error == "dependency_loop_single" %]
    [% title = "Beroendeslinga upptäckt" %]
    Du kan inte låta [% terms.abug %] blockera sig själv eller bero på sig själv.

  [% ELSIF error == "dupe_id_required" %]
    [% title = "ID för dubblett-" _ terms.Bug _ " krävs" %]
    Du måste ange ID:t för [% terms.abug %] för att markera denna [% terms.bug %]
    som en dubblett.

  [% ELSIF error == "dupe_not_allowed" %]
    [% title = "Det går inte att markera " _ terms.bugs _ " som dubbletter" %]
    Du kan inte markera [% terms.bugs %] som dubbletter när
    du ändrar flera [% terms.bugs %] samtidigt.

  [% ELSIF error == "dupe_loop_detected" %]
    [% title = "Slinga upptäckt bland dubbletter" %]
    Du kan inte markera [% terms.bug %] [%+ bug_id FILTER html %] som
    en dubblett av
    [% IF dupe_of == bug_id %]
      sig själv
    [% ELSE %]
      [%+ terms.bug %] [%+ dupe_of FILTER html %], eftersom det
      skulle skapa en dubblettslinga
    [% END %].

  [% ELSIF error == "email_change_in_progress" %]
    [% title = "Byte av e-postadress pågår redan" %]
    Byte av e-postadress pågår redan. Kontrollera din e-post.

  [% ELSIF error == "email_no_body" %]
    Ditt meddelande innehöll ingen text, så långt vi kunde avgöra.

  [% ELSIF error == "empty_group_description" %]
    [% title = "Gruppbeskrivningen får inte vara tom" %]
    Du måste ange en beskrivning för gruppen.

  [% ELSIF error == "empty_group_name" %]
    [% title = "Gruppnamnet får inte vara tomt" %]
    Du måste ange ett namn för gruppen.
  
  [% ELSIF error == "entry_access_denied" %]
    [% title = "Åtkomst nekad" %]
    [% admindocslinks = {'categorization.html#product-group-controls' => 'Group Security'} %]
    Produkten <em>[% product FILTER html %]</em> finns antingen inte
    eller så har du inte behörighet att
    rapportera [% terms.abug %] i den.

  [% ELSIF error == "extension_create_no_name" %]
    Du måste ange ett namn på tillägget som argument till skriptet.

  [% ELSIF error == "extension_disabled" %]
    [% title = "Tillägget är inaktiverat" %]
    Du kan inte öppna sidan eftersom tillägget ”[% name FILTER html %]”
    är inaktiverat.

  [% ELSIF error == "extension_first_letter_caps" %]
    Den första bokstaven i tilläggets namn måste vara en versal.
    (Du angav ”[% name FILTER html %]”.)

  [% ELSIF error == "feature_disabled" %]
    Funktionen [% install_string("feature_$feature") FILTER html %] är inte
    tillgänglig i denna Bugzilla.
    [% IF user.in_group('admin') %]
      Kör <kbd>checksetup.pl</kbd> om du vill aktivera funktionen för att se
      hur de nödvändiga kraven installeras.
    [% END %]

  [% ELSIF error == "field_already_exists" %]
    [% title = "Fältet finns redan" %]
    Fältet ”[% field.name FILTER html %]”
    ([% field.description FILTER html %]) finns redan. Välj
    ett annat namn.

  [% ELSIF error == "field_cant_control_self" %]
