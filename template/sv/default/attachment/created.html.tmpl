[%# INTERFACE:
  # attachment: object of the attachment just created.
  # contenttypemethod: string. How we got the content type of the attachment.
  #  Possible values: autodetect, list, manual.
  #%]

[% bug = bugs.0 %]
[% PROCESS "bug/show-header.html.tmpl" %]
[% PROCESS global/header.html.tmpl
  title = "Bilaga $attachment.id lades till i $terms.Bug $attachment.bug_id"
%]

<dl>
  <dt>
    <a title="[% attachment.description FILTER html %]"
       href="attachment.cgi?id=[% attachment.id %]&amp;action=edit">Bilaga #[% attachment.id %]</a>
    till [% "$terms.bug $attachment.bug_id" FILTER bug_link(attachment.bug_id) FILTER none %] har skapats
  </dt>
  <dd>
    [% PROCESS "bug/process/bugmail.html.tmpl" mailing_bugid = attachment.bug_id %]
    [% IF convertedbmp %]
      <p>
        <b>Observera:</b> Bugzilla har automatiskt konverterat din BMP-bildfil
        till komprimerat PNG-format.
      </p>
    [% END %]
    [% IF contenttypemethod == 'autodetect' %]
      <p>
        <b>Observera:</b> Bugzilla har automatiskt upptäckt innehållstypen
        <em>[% attachment.contenttype FILTER html %]</em> för den här bilagan. Om den är
        felaktig kan du ändra värdet under bilagans
        <a href="attachment.cgi?id=[% attachment.id %]&amp;action=edit">detaljer</a>.
      </p>
    [% END %]

    [% Hook.process("links") %]
  </dd>
</dl>

<p>
<a href="attachment.cgi?bugid=[% attachment.bug_id %]&amp;action=enter">Skapa
 ytterligare en bilaga till [% terms.Bug %] [%+ attachment.bug_id %]</a>
</p>

[% PROCESS bug/show.html.tmpl %]
