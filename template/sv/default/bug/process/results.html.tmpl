[% UNLESS header_done %]
  [% PROCESS bug/process/header.html.tmpl %]
[% END %]

[% DEFAULT type="bug" %]

[% link = BLOCK %][% terms.bug %] [%+ id FILTER bug_link(id) FILTER none %][% END %]

[%
  title = {
    'bug' => "Ändringar har skickats för $link" ,
    'dupe' => "Dubblettmarkering har lagts till för $link" ,
    'dep' => "Kontrollerar beroendeändringar för $link" ,
    'created' => "$link har skapats" ,
    'move' => "$link har flyttats till en annan databas" ,
  }
%]

[% Hook.process('title') %]

<dl>
  <dt>[% title.$type.ucfirst %]</dt>
  <dd>
    [% PROCESS "bug/process/bugmail.html.tmpl" mailing_bugid = id %]
    [% Hook.process("links") %]
  </dd>
</dl>
