[% IF classification %]
  [% classification_url_part = BLOCK %]&amp;classification=
    [%- classification.name FILTER uri %]
  [%- END %]
  [% classification_title = BLOCK %]
    i klassificeringen ”[% classification.name FILTER html %]”
  [% END %]
[% END %]

[% PROCESS global/header.html.tmpl
  title = "Välj produkt$classification_title"
  style_urls = ['skins/standard/admin.css']
%]

[% columns = [
     {
       name => "name"
       heading => "Redigera produkt ..."
       contentlink => 'editproducts.cgi?action=edit&amp;product=%%name%%'
     },
     {
       name => "description"
       heading => "Beskrivning"
       allow_html_content => 1
     },
     {
       name => "is_active"
       heading => "Öppen för nya $terms.Bugs"
       yesno_field => 1
     },
     {
       name => "allows_unconfirmed"
       heading => "Tillåt " _ display_value('bug_status', 'UNCONFIRMED') _
                       " för " _ terms.Bugs
       yesno_field => 1
     },
] %]

[% IF showbugcounts %]

  [% columns.push({
       name => "bug_count"
       heading => "Antal $terms.bugs"
       class => 'right'
       contentlink => 'buglist.cgi?product=%%name%%'
     })
  %]

[% END %]

[% columns.push({
       heading => "Åtgärd"
       content => "Ta bort"
       contentlink => 'editproducts.cgi?action=del&amp;product=%%name%%'
     })
%]

[% Hook.process('before_table') %]

[% PROCESS admin/table.html.tmpl
     columns = columns
     data = products
%]

[% IF !showbugcounts %]

  <p><a href="editproducts.cgi?showbugcounts=1[% classification_url_part %]">
      Visa tabellen igen med antal [% terms.bugs %] (långsammare)</a></p>

[% END %]

[% PROCESS admin/products/footer.html.tmpl
    no_edit_other_products_link = 1
 %]

[% PROCESS global/footer.html.tmpl %]
