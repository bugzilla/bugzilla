[% filtered_summary = bugsummary FILTER html %]
[% header = BLOCK %]Visa alla bilagor för
  [%+ "$terms.Bug $bug.id" FILTER bug_link(bug) FILTER none %][% END %]

[% title = BLOCK %]
  Visa alla bilagor för [% terms.Bug %] [%+ bug.bug_id FILTER html %]
[% END %]

[% PROCESS global/header.html.tmpl
  title = title
  header = header
  subheader = filtered_summary
  style_urls = ['skins/standard/bug.css']
%]
[% IF hide_obsolete %]
  <div id="hidden_obsolete_message">
    Föråldrade bilagor är dolda. Om du vill se alla bilagor, även föråldrade,
    <a href="attachment.cgi?bugid=[% bug.id FILTER html %]&amp;action=viewall">klicka här</a>.
  </div>
[% END %]

[% FOREACH a = attachments %]
<div class="viewall_frame_container">
  <table class="viewall_desc">
    <tr>
      <th colspan="6" class="bz_attach_footer">Bilaga #[% a.id %]</th>
    </tr>
    <tr>
      <td>[% a.description FILTER html FILTER obsolete(a.isobsolete) %]</td>
      <td>[% IF a.ispatch %]<i>patch</i>[% ELSE %][% a.contenttype FILTER html %][% END %]</td>
      <td>[% a.attached FILTER time %]</td>
      <td>[% a.datasize FILTER unitconvert %]</td>
      <td>
        [% IF a.flags.size == 0 %]<i>inga flaggor</i>[% ELSE %]
          [% FOREACH flag = a.flags %]
            [% flag.setter.nick FILTER html %]:
            [%+ flag.type.name FILTER html %][% flag.status %]
            [% IF flag.status == "?" && flag.requestee %]([% flag.requestee.nick FILTER html %])[% END %]
            [% ", " IF !loop.last %]
          [% END %]
        [% END %]
      </td>
      <td><a href="attachment.cgi?id=[% a.id %]&amp;action=edit">Detaljer</a></td>
    </tr>
  </table>
  [% IF a.is_viewable %]
    [% IF a.contenttype == "text/html" %]
      [% INCLUDE global/textarea.html.tmpl minrows = 10 cols = 80 defaultcontent = a.data readonly = 'readonly' classes = 'viewall_frame' %]
    [% ELSE %]
      <iframe src="attachment.cgi?id=[% a.id %]" class="viewall_frame" sandbox>
        <b>Bilagan kan inte visas på den här sidan eftersom webbläsaren inte stöder IFRAME.
        <a href="attachment.cgi?id=[% a.id %]">Visa bilagan på en egen sida</a>.</b>
      </iframe>
    [% END %]
  [% ELSE %]
    <p><b>
      Bilagan kan inte visas eftersom dess MIME-typ inte är text/*, image/* eller application/vnd.mozilla.*.
      <a href="attachment.cgi?id=[% a.id %]">Hämta bilagan i stället</a>.
    </b></p>
  [% END %]
</div>
[% END %]

[% PROCESS global/footer.html.tmpl %]
