[%# INTERFACE:
  # attachment: object of the attachment we just attached.
  #%]

[% bug = bugs.0 %]

[% PROCESS "bug/show-header.html.tmpl" %]
[% PROCESS global/header.html.tmpl
  title = "Ändringar skickades för bilaga $attachment.id till $terms.Bug $attachment.bug_id"
%]

<dl>
  <dt>Ändringar i
    <a href="attachment.cgi?id=[% attachment.id %]&amp;action=edit">bilaga [% attachment.id %]</a>
    till [% "$terms.bug $attachment.bug_id" FILTER bug_link(attachment.bug_id) FILTER none %] har skickats
  </dt>
  <dd>
    [% PROCESS "bug/process/bugmail.html.tmpl" mailing_bugid = attachment.bug_id %]
    [% Hook.process("links") %]
  </dd>
</dl>

[% PROCESS bug/show.html.tmpl %]
