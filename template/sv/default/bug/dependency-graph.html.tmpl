[% title = "Beroendegraf" header = title %]
[% IF NOT multiple_bugs %]
  [% filtered_desc = short_desc FILTER html %]
  [% title = "$title för $terms.bug $bug_id" header = "$header för $terms.bug <a href=\"show_bug.cgi?id=$bug_id\">$bug_id</a>" subheader = filtered_desc %]
[% END %]
[% PROCESS global/header.html.tmpl %]
[% image_map %]
<p>Gröna cirklar visar öppna [% terms.bugs %].</p>
[% IF image_map %]
  <img src="[% image_url %]" alt="Beroendegraf" usemap="#imagemap">
[% ELSE %]
  <a href="[% map_url %]"><img src="[% image_url %]" alt="Beroendegraf" ismap="ismap"></a>
[% END %]
<hr>
<form action="showdependencygraph.cgi" method="GET">
  <table>
    <tr><th><label for="id">[% terms.Bug %]-nummer</label>:</th><td><input id="id" name="id" value="[% bug_id %]"></td>
      <td><input type="checkbox" id="showsummary" name="showsummary" [% " checked" IF showsummary %]>
        <label for="showsummary">Visa sammanfattningar för alla visade [% terms.bugs %]</label></td></tr>
    <tr><th><label for="display">Visa:</label></th><td colspan="2"><select id="display" name="display">
      <option value="tree"[% 'selected="selected"' IF (!display || display == "tree") %]>Begränsa till [% terms.bugs %] med en direkt relation till angivna [% terms.bugs %]</option>
      <option value="web" [% 'selected="selected"' IF display == "web" %]>Visa alla [% terms.bugs %] med en relation till angivna [% terms.bugs %]</option>
    </select></td></tr>
    <tr><th><label for="rankdir">Riktning:</label></th><td colspan="2"><select id="rankdir" name="rankdir">
      <option value="TB"[% " selected" IF rankdir == "TB" %]>Uppifrån och ned</option>
      <option value="BT"[% " selected" IF rankdir == "BT" %]>Nedifrån och upp</option>
      <option value="LR"[% " selected" IF rankdir == "LR" %]>Vänster till höger</option>
      <option value="RL"[% " selected" IF rankdir == "RL" %]>Höger till vänster</option>
    </select></td></tr>
  </table>
  <input type="submit" id="change" value="Ändra parametrar">
</form>
[% PROCESS global/footer.html.tmpl %]
