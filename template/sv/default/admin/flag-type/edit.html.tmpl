[% PROCESS "global/js-products.html.tmpl" %]

[% IF action == "insert" %]
  [% title = BLOCK %]
    Skapa flaggtyp för [% type.target_type == "bug" ? terms.Bugs : "bilagor" %]
    [% IF type.id %]
      Baserad på [% type.name FILTER html %]
    [% END %]
  [% END %]
[% ELSE %]
  [% title = BLOCK %]Redigera flaggtypen [% type.name FILTER html %][% END %]
[% END %]

[% PROCESS global/header.html.tmpl
  title = title
  style_urls = ['skins/standard/admin.css']
  onload="var f = document.forms['flagtype_properties'];
          selectProduct(f.product, f.component, '__Any__');"
  javascript_urls=["js/productform.js"]
  doc_section = "administering/flags.html"
%]

<form id="flagtype_properties" method="post" action="editflagtypes.cgi">
  <input type="hidden" name="action" value="[% action FILTER html %]">
  <input type="hidden" name="can_fully_edit" value="[% can_fully_edit FILTER html %]">
  <input type="hidden" name="id" value="[% type.id FILTER html %]">
  <input type="hidden" name="token" value="[% token FILTER html %]">
  <input type="hidden" name="target_type" value="[% type.target_type FILTER html %]">
  <input type="hidden" name="check_clusions" value="[% check_clusions FILTER none %]">
  [% FOREACH category = inclusions.values %]
    <input type="hidden" name="inclusions" value="[% category FILTER html %]">
  [% END %]
  [% FOREACH category = exclusions.values %]
    <input type="hidden" name="exclusions" value="[% category FILTER html %]">
  [% END %]

  [%# Add a hidden button at the top of the form so that the user pressing "return"
    # really submit the form, as expected. %]
  <input type="submit" id="commit" value="Spara" class="bz_default_hidden">

  <table id="admin_table_edit">
    <tr>
      <th>Namn:</th>
      <td>
        ett kort namn som identifierar den här typen.<br>
        <input type="text" name="name" value="[% type.name FILTER html %]" size="50"
               maxlength="50" [%- ' disabled="disabled"' UNLESS can_fully_edit %] required>
      </td>
    </tr>

    <tr>
      <th>Beskrivning:</th>
      <td>
        en utförlig beskrivning av den här typen.<br>
        [% INCLUDE global/textarea.html.tmpl
          name           = 'description'
          minrows        = 4
          cols           = 80
          defaultcontent = type.description
          disabled       = !can_fully_edit
          mandatory      = 1
        %]
      </td>
    </tr>

    <tr>
      <th>Kategori:</th>

      <td>
        de produkter eller komponenter som [% type.target_type == "bug" ? terms.bugs : "bilagor" %]
        måste tillhöra (inkluderingar) eller inte får tillhöra (exkluderingar) för att
        användare ska kunna ange flaggor av den här typen.
        [% UNLESS can_fully_edit %]
          <p class="warning">Flaggtypen gäller också vissa produkter som du saknar behörighet
          att redigera och därför inte visas i listorna nedan. Dina begränsade behörigheter
          innebär att du bara kan lägga till och ta bort flaggtypen för produkter du kan
          redigera, inte ändra flaggtypens andra egenskaper.</p>
        [% END %]
        <table>
          <tr>
            <th class="top left">
              Produkt/komponent:<br>
              [% INCLUDE "global/product-select.html.tmpl"
                id       => "product"
                name     => "product"
                add      => "__Any__"
                onchange => "selectProduct(this, this.form.component, '__Any__');"
                products => products
              %]<br>
              <select name="component">
                <option value="">__Any__</option>
                [% FOREACH comp = components %]
                  <option value="[% comp FILTER html %]">[% comp FILTER html %]</option>
                [% END %]
              </select><br>
              <input type="submit" id="categoryAction-include" 
                                   name="categoryAction-include" value="Inkludera">
              <input type="submit" id="categoryAction-exclude"
                                   name="categoryAction-exclude" value="Exkludera">
            </th>
            <th class="top left">
              Inkluderingar:<br>
              [% PROCESS category_select name="inclusion_to_remove" categories = inclusions %]<br>
              <input type="submit" id="categoryAction-removeInclusion" 
                     name="categoryAction-removeInclusion" value="Ta bort inkludering">
            </th>
            <th class="top left">
              Exkluderingar:<br>
              [% PROCESS category_select name="exclusion_to_remove" categories = exclusions %]<br>
              <input type="submit" id="categoryAction-removeExclusion" 
                     name="categoryAction-removeExclusion" value="Ta bort exkludering">
            </th>
          </tr>
        </table>
      </td>
    </tr>

    <tr>
      <th>Sorteringsnyckel:</th>
      <td>
        ett tal mellan 0 och [% constants.MAX_SMALLINT FILTER none %] som
        styr hur typen sorteras när den visas för användare i en lista. Lämna fältet
        om du inte bryr dig om ordningen eller vill att typerna visas
        i alfabetisk ordning.<br>
        <input type="text" name="sortkey" value="[% type.sortkey || 0 FILTER html %]" size="5"
               maxlength="5" [% ' disabled="disabled"' UNLESS can_fully_edit %] required>
      </td>
    </tr>

    <tr>
      <th>&nbsp;</th>
      <td>
        <input type="checkbox" id="is_active" name="is_active"
               [%- ' disabled="disabled"' UNLESS can_fully_edit %]
               [% " checked" IF type.is_active || !type.is_active.defined %]>
        <label for="is_active">aktiv (flaggor av typen visas i användargränssnittet och kan anges)</label>
      </td>
    </tr>

    <tr>
      <th>&nbsp;</th>
      <td>
        <input type="checkbox" id="is_requestable" name="is_requestable"
               [%- ' disabled="disabled"' UNLESS can_fully_edit %]
               [% " checked" IF type.is_requestable || !type.is_requestable.defined %]>
        <label for="is_requestable">begärbar (användare kan be att flaggor av typen anges)</label>
      </td>
    </tr>

    <tr>
      <th>CC-lista:</th>
      <td>
        om typen är begärbar, vilka som ska få en kopia av e-postaviseringar om begäranden.
        Det här är en kommaseparerad lista med fullständiga e-postadresser som inte
        behöver vara inloggningsnamn för [% terms.Bugzilla %].
        [% IF Param('emailsuffix') %]
          Observera att det konfigurerade e-postsuffixet
          <kbd>[% Param('emailsuffix') %]</kbd> <em>inte</em> läggs till
          i adresserna. Lägg därför till det uttryckligen om du vill använda det.
        [% END %]<br>
        <input type="text" name="cc_list" value="[% type.cc_list FILTER html %]" size="80"
               maxlength="200" [%- ' disabled="disabled"' UNLESS can_fully_edit %]>
      </td>
    </tr>

    <tr>
      <th>&nbsp;</th>
      <td>
        <input type="checkbox" id="is_requesteeble" name="is_requesteeble"
               [%- ' disabled="disabled"' UNLESS can_fully_edit %]
               [% " checked" IF type.is_requesteeble || !type.is_requesteeble.defined %]>
        <label for="is_requesteeble">begärbar från specifika användare (användare kan be andra angivna användare
          att ange flaggor av typen i stället för att skicka en allmän begäran)</label>
      </td>
    </tr>

    <tr>
      <th>&nbsp;</th>
      <td>
        <input type="checkbox" id="is_multiplicable" name="is_multiplicable"
               [%- ' disabled="disabled"' UNLESS can_fully_edit %]
               [% " checked" IF type.is_multiplicable || !type.is_multiplicable.defined %]>
        <label for="is_multiplicable">flerfaldig (flera flaggor av typen kan anges för
          samma [% type.target_type == "bug" ? terms.bug : "bilaga" %])</label>
      </td>
    </tr>

    <tr>
      <th>Grupp för godkännande:</th>
      <td>
        gruppen som får godkänna eller avslå flaggor av den här typen
        (välj ingen grupp om alla användare ska få godkänna eller avslå flaggorna).<br>
        [% PROCESS group_select selname = "grant_group" %]
      </td>
    </tr>

    <tr>
      <th>Grupp för begäran:</th>
      <td>
        om flaggor av den här typen är begärbara, gruppen som får begära dem
        (välj ingen grupp om alla användare ska få begära flaggorna).<br>
        Observera att gruppen för begäran saknar effekt om ingen grupp för godkännande är angiven.<br>
        [% PROCESS group_select selname = "request_group" %]
      </td>
    </tr>

    <tr>
      <th>&nbsp;</th>
      <td>
        <input type="submit" id="save" value="[% action == "insert" ? "Skapa" : "Spara ändringar" %]">
      </td>
    </tr>

  </table>

</form>

[% PROCESS global/footer.html.tmpl %]


[%############################################################################%]
[%# Block for SELECT fields                                                  #%]
[%############################################################################%]

[% BLOCK group_select %]
  <select name="[% selname %]" id="[% selname %]" [%- ' disabled="disabled"' UNLESS can_fully_edit %]>
    <option value="">(ingen grupp)</option>
    [% group_found = 0 %]
    [% FOREACH group = groups %]
      <option value="[% group.name FILTER html %]"
        [% IF type.${selname} && type.${selname}.name == group.name %]
          [% ' selected="selected"' %]
          [% group_found = 1 %]
        [% END %]>
        [%- group.name FILTER html ~%]
      </option>
    [% END %]
    [% IF !group_found && type.${selname}.name %]
      <option value="[% type.${selname}.name FILTER html %]" selected="selected">
        [%- type.${selname}.name FILTER html ~%]
      </option>
    [% END %]
  </select>
[% END %]

[% BLOCK category_select %]
  <select name="[% name FILTER html %]" multiple="multiple" size="7">
    [% FOREACH option = categories.keys.sort %]
      <option value="[% categories.$option FILTER html %]">
        [% option FILTER html %]
      </option>
    [% END %]
  </select>
[% END %]
