<div id="permissions">
  [% IF has_bits.size %]
    <p>Följande behörigheter är aktiverade för ditt konto:</p>
    <table>[% FOREACH bit_description = has_bits %]<tr><td>[% bit_description.name FILTER html %]</td><td>[% bit_description.desc FILTER html_light %]</td></tr>[% END %]</table>
    [% FOREACH privs = ["editcomponents", "canconfirm", "editbugs"] %]
      [% SET products = ${"local_$privs"} %]
      [% IF products && products.size %]<p>Du har även den lokala behörigheten '[% privs FILTER html %]' för följande produkter:</p><ul>[% FOREACH product = products %]<li>[% product.name FILTER html %]</li>[% END %]</ul>[% END %]
    [% END %]
  [% ELSE %]
    <p>Inga behörigheter är aktiverade för ditt konto.</p>
  [% END %]
  [% IF user.in_group('editusers') %]
    <p>Du har behörigheten editusers. Du kan aktivera och inaktivera alla behörigheter för alla användare.</p>
  [% ELSIF set_bits.size %]
    <p>Du kan även aktivera eller inaktivera följande behörigheter för <a href="editusers.cgi">andra användare</a>:</p>
    <table>[% FOREACH bit_description = set_bits %]<tr><td>[% bit_description.name FILTER html %]</td><td>[% bit_description.desc FILTER html_light %]</td></tr>[% END %]</table>
  [% END %]
  [% IF user.in_group('bz_sudoers') %]<p>Du är medlem i gruppen <b>bz_sudoers</b> och kan därför <a href="relogin.cgi?action=prepare-sudo">uppträda som någon annan</a>.</p>[% END %]
</div>
