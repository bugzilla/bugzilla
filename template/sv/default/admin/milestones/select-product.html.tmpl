[% PROCESS global/header.html.tmpl
  title = "Vilken produkts milstolpar vill du redigera?"
  style_urls = ['skins/standard/admin.css']
%]

[% columns = [
     {
       name => "name"
       heading => "Redigera milstolpar för ..."
       contentlink => "editmilestones.cgi?product=%%name%%"
     },
     {
       name => "description"
       heading => "Beskrivning"
       allow_html_content => 1
     }
   ]
%]

[% IF showbugcounts %]

  [% columns.push({
      name => 'bug_count'
      heading => "$terms.Bugs"
      class => "right"
      contentlink => "buglist.cgi?product=%%name%%"
    })
  %]

[% END %]

[% PROCESS admin/table.html.tmpl
     columns = columns
     data = products
%]

[% IF !showbugcounts %]
  <p><a href="editmilestones.cgi?showbugcounts=1">
      Visa tabellen igen med antal [% terms.bug %] (långsammare)</a></p>
[% END %]

[% PROCESS global/footer.html.tmpl %]
