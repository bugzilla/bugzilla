[% filtered_desc = bug.short_desc FILTER html %]
[% PROCESS global/header.html.tmpl
  title = "Ändringar i $terms.bug $bug.bug_id"
  header = "Aktivitetslogg för $terms.bug $bug.bug_id: $filtered_desc"
 %]

<p>
  Tillbaka till [% "$terms.bug $bug.bug_id" FILTER bug_link(bug) FILTER none %]
</p>

[% PROCESS bug/activity/table.html.tmpl %]

[% IF operations.size > 0 %]
  <p>
    Tillbaka till [% "$terms.bug $bug.bug_id" FILTER bug_link(bug) FILTER none %]
  </p>
[% END %]

[% PROCESS global/footer.html.tmpl %]
