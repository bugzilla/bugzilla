[% PROCESS global/header.html.tmpl
  title = terms.Bug _ "fält"
  bodyclasses = ['narrow_page']
%]

<p>Den här sidan beskriver de olika fälten som visas
  för [% terms.abug %].</p>

<table class="field_value_explanation">
  <thead>
  <tr>
    <td id="bug_status">
      <h2>[% field_descs.bug_status FILTER upper FILTER html %]</h2>
    </td>

    <td id="resolution">
      <h2>[% field_descs.resolution FILTER upper FILTER html %]</h2>
    </td>
  </tr>

  <tr>
    <td>Fältet [% field_descs.bug_status FILTER html %] visar det aktuella
      tillståndet för [% terms.abug %]. Endast vissa statusövergångar
      är tillåtna.</td>

    <td>Fältet [% field_descs.resolution FILTER html %] visar vad som
      hände med [%+ terms.abug %].</td>
  </tr>
  </thead>

  <tbody>
  <tr class="header_row">
    <td colspan="2">Öppna [% terms.bugs %]</td>
  </tr>
  <tr>
    <td>
      <dl>
        <dt class="unconfirmed">
          [% display_value("bug_status", "UNCONFIRMED") FILTER html %]
        </dt>
        <dd class="unconfirmed">
          Den här [% terms.bug %] har nyligen lagts till i databasen.
          Ingen har bekräftat att [% terms.bug %] är giltig. Användare
          med behörigheten "canconfirm" kan bekräfta
          [% terms.bug %], vilket ändrar statusen till
          <b>[% display_value("bug_status", "CONFIRMED") FILTER html %]</b>. 
          Den kan också lösas direkt och markeras som
          <b>[% display_value("bug_status", "RESOLVED") FILTER html %]</b>.
        </dd>

        <dt class="confirmed">
          [% display_value("bug_status", "CONFIRMED") FILTER html %]
        </dt>
        <dd class="confirmed">
          Den här [% terms.bug %] är giltig och har nyligen rapporterats.
          [%+ terms.Bugs %] med den här statusen blir
          <b>[% display_value("bug_status", "IN_PROGRESS") FILTER html %]</b>
          när någon arbetar med dem, eller löses och markeras som
          <b>[% display_value("bug_status", "RESOLVED") FILTER html %]</b>.
        </dd>

        <dt class="in_progress">
          [% display_value("bug_status", "IN_PROGRESS") FILTER html %]
        </dt>
        <dd class="in_progress">
          Den här [% terms.bug %] är inte löst ännu, men den är tilldelad
          den person som arbetar med den. Härifrån kan [%+ terms.bugs %]
          tilldelas någon annan och få statusen
          <b>[% display_value("bug_status", "CONFIRMED") FILTER html %]</b>, or
          lösas och få statusen
          <b>[% display_value("bug_status", "RESOLVED") FILTER html %]</b>.
        </dd>
        
        [% Hook.process('open-status') %]
      </dl>
    </td>

    <td>
      Ingen lösning ännu. Alla [% terms.bugs %] med någon av
      dessa öppna statusar saknar angiven lösning.
    </td>
  </tr>

  <tr class="header_row">
    <td colspan="2">Stängda [% terms.bugs %]</td>
  </tr>

  <tr>
    <td>
      <dl>
        <dt class="resolved">
          [% display_value("bug_status", "RESOLVED") FILTER html %]
        </dt>
        <dd class="resolved">
          En lösning har genomförts och inväntar verifiering av
          kvalitetssäkringen. Härifrån öppnas [% terms.bugs %] antingen igen
          med en öppen status eller verifieras av kvalitetssäkringen och markeras som
          <b>[% display_value("bug_status", "VERIFIED") FILTER html %]</b>.
        </dd>

        <dt class="verified">
          [% display_value("bug_status", "VERIFIED") FILTER html %]
        </dt>
        <dd class="verified">
          Kvalitetssäkringen har granskat [% terms.bug %] och lösningen och
          instämmer i att rätt åtgärd har vidtagits. Det här är
          slutstatusen för [% terms.bugs %].
        </dd>
        
        [% Hook.process('closed-status') %]
      </dl>
    </td>

    <td>
      <dl>
        <dt class="fixed">
          [% display_value("resolution", "FIXED") FILTER html %]
        </dt>
        <dd class="fixed">
          En korrigering för [% terms.bug %] har lagts in i källkoden och
          testats.
        </dd>

        <dt class="invalid">
          [% display_value("resolution", "INVALID") FILTER html %]
        </dt>
        <dd class="invalid">
          Det beskrivna problemet är inte [% terms.abug %].
        </dd>

        <dt class="wontfix">
          [% display_value("resolution", "WONTFIX") FILTER html %]
        </dt>
        <dd class="wontfix">
          Det beskrivna problemet är [% terms.abug %] som aldrig kommer att
          åtgärdas.
        </dd>

        <dt class="duplicate">
         [% display_value("resolution", "DUPLICATE") FILTER html %]
        </dt>
        <dd class="duplicate">
          Problemet är en dubblett av en befintlig [% terms.bug %].
          När [% terms.abug %] markeras som
          <b>[% display_value("resolution", "DUPLICATE") FILTER html %]</b>,
          visas bredvid lösningen vilken [% terms.bug %] den är en dubblett av.
        </dd>

        <dt class="worksforme">
          [% display_value("resolution", "WORKSFORME") FILTER html %]
        </dt>
        <dd class="worksforme">
          Alla försök att återskapa [% terms.bug %] har misslyckats,
          och källkoden ger inga ledtrådar till varför det beskrivna
          beteendet uppstår. Om mer information framkommer kan
          [% terms.bug %] öppnas igen.
        </dd>
        
        [% Hook.process('resolution') %]
      </dl>
    </td>
  </tr>
  </tbody>
</table>

<h2>Andra fält</h2>

[% SET field_help_map = {} %]
[% FOREACH field = bug_fields.keys %]
  [% SET field_desc = field_descs.$field %]
  [% field_help_map.$field_desc = { help  => help_html.$field, 
                                    field => field } %]
[% END %]

[%# This field is not a real one, but its label is visible in bugs. %]

[% field_help_map.Importance = { help  => help_html.importance,
                                 field => "importance" } %]

[%# These are fields that don't need to be documented, either because
  # they have docs somewhere else in the UI, or they don't show up on bugs. 
  # %]
[% SET skip_fields = [ 
  'days_elapsed', 
  'everconfirmed',
  'reporter_accessible',
  'cclist_accessible',
  'bug_group',
  'commenter',
  'owner_idle_time',
  'bug_status',
  'resolution',
] %]

<dl class="field_descriptions">
[% FOREACH field_desc = field_help_map.keys.sort %]
  [% SET field = field_help_map.${field_desc}.field %]
  [% SET field_object = bug_fields.$field %]

  [% NEXT IF field_object.obsolete %]
  [% NEXT IF !user.is_timetracker AND field_object.is_timetracking %]

  [% NEXT IF field == 'status_whiteboard' AND !Param('usestatuswhiteboard') %]
  [% NEXT IF field == 'target_milestone' AND !Param('usetargetmilestone') %]

  [%# For now we don't have help for attachment fields and so on. %]
  [% NEXT IF field.match('\.') %]

  [% NEXT IF skip_fields.contains(field) %]

  <dt id="[% field FILTER html %]">[% field_desc FILTER html %]</dt>
    <dd>
      [% field_help_map.${field_desc}.help FILTER html_light %]
    </dd>
[% END %]
</dl>

[% PROCESS global/footer.html.tmpl %]
