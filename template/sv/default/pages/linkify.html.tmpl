[% INCLUDE global/header.html.tmpl title = "Länka text" %]

<p>
  Om du skriver in text returnerar formuläret den formaterad som en vanlig
  Bugzilla-kommentar. Giltiga nummer för [% terms.bugs %], URL:er,
  e-postadresser och liknande ersätts med lämpliga HTML-länkar.
</p>

<form action="page.cgi" method="post">
  [% INCLUDE global/textarea.html.tmpl
    name    = 'text'
    minrows = 20
    cols    = constants.COMMENT_COLS
  %]
  <br>
  <input type="hidden" name="id" value="linked.html">
  <input type="submit" id="linkify" value="Länka">
</form>

[% INCLUDE global/footer.html.tmpl %]

