[% IF donation %]
  <div class="donation_banner home_banner[% ' donation_banner_preferences' UNLESS show_dismissal %]">
    <div class="donation_banner_layout">
      <img src="extensions/BugzillaDonationBanner/web/buggie_watering.svg"
           alt="Buggie watering a plant" class="donation_banner_image">
      <div class="donation_banner_content">
        [% IF donation.show_thanks %]
          <p class="donation_banner_thanks">Thanks for upgrading Bugzilla!</p>
        [% END %]
        <p class="donation_banner_message">[% donation.message FILTER html %]</p>
        <p class="donation_banner_cta_row">
          <a href="[% donation.url FILTER html %]" class="donation_banner_cta">Donate to Bugzilla</a>
        </p>
        [% IF show_dismissal %]
          <details class="donation_banner_dismissal">
            <summary>Remind me later or dismiss this message</summary>
            <form method="post"
                  action="extensions/BugzillaDonationBanner/bin/donate.cgi"
                  class="donation_banner_form donation_banner_form_subtle">
              <input type="hidden" name="token" value="[% donation.token FILTER html %]">
              <label for="donate_action" class="donation_banner_label">Dismiss and:</label>
              <select id="donate_action" name="donate_action" class="donation_banner_select" required>
                <option value="" selected disabled>Select one</option>
                <option value="next_upgrade">Remind me after the next Bugzilla upgrade</option>
                <option value="week">Remind me in a week</option>
                <option value="month">Remind me in a month</option>
                <option value="date">Pick a date for my next reminder</option>
                <option value="never">Never show this to me again</option>
              </select>
              <span id="donate_banner_date_field" class="donation_banner_date_field" hidden>
                <label for="donate_banner_reminder_date" class="donation_banner_label">Date:</label>
                <input type="date" id="donate_banner_reminder_date"
                       name="donate_banner_reminder_date" value="[% donation.today FILTER html %]">
              </span>
              <button type="submit" class="donation_banner_submit">Save</button>
            </form>
            <p class="donation_banner_preferences_note">
              You can change this choice later from your
              <a href="userprefs.cgi?tab=donate">Donate to Bugzilla preferences</a>.
            </p>
          </details>
        [% END %]
        [% IF donation.visibility_note %]
          <p class="notice">[% donation.visibility_note FILTER html %]
          You can configure this notification from the
          <a href="[% donation.settings_link FILTER none %]">Parameters</a> page.</p>
        [% END %]
      </div>
    </div>
  </div>
[% END %]
